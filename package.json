{
	"private": true,
	"packageManager": "bun@1.4.0",
	"workspaces": [
		"packages/*",
		"playground",
		"tools/*"
	],
	"scripts": {
		"dev": "bun run --filter astlide-playground dev",
		"build": "bun run --filter astlide-playground build",
		"preview": "bun run --filter astlide-playground preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "cd playground && bunx astro sync && node --import ../scripts/use-typescript6.mjs ../scripts/typecheck.mjs",
		"test:e2e": "vitest run --config vitest.config.e2e.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write .",
		"docs": "bun run --cwd packages/astlide docs",
		"changeset": "changeset",
		"version": "changeset version && bun install",
		"release": "changeset publish"
	},
	"devDependencies": {
		"@astrojs/language-server": "^2.17.2",
		"@biomejs/biome": "^2.5.15",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@types/pixelmatch": "^7.1.0",
		"@types/pngjs": "^6.0.5",
		"agent-browser": "^0.38.2",
		"jszip": "3.10.2",
		"pixelmatch": "^7.2.0",
		"pngjs": "^7.0.0",
		"pptxgenjs": "^4.0.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3",
		"zod": "^4.6.5"
	}
}

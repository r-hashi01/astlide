{
	"private": true,
	"packageManager": "bun@1.4.0",
	"workspaces": [
		"packages/*",
		"playground",
		"docs",
		"tools/*"
	],
	"scripts": {
		"dev": "bun run --filter astlide-playground dev",
		"build": "bun run --filter astlide-playground build",
		"preview": "bun run --filter astlide-playground preview",
		"export": "bun packages/astlide/src/cli/astlide.ts export --cwd playground",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "cd playground && bunx astro sync && node --import ../scripts/use-typescript6.mjs ../scripts/typecheck.mjs && tsc -p ../packages/server",
		"test:e2e": "vitest run --config vitest.config.e2e.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write .",
		"docs:api": "bun run --cwd packages/astlide docs",
		"docs:dev": "bun run --filter astlide-docs dev",
		"docs:build": "bun run docs:api && bun run --filter astlide-docs build",
		"changeset": "changeset",
		"version": "changeset version && bun install --ignore-scripts",
		"release": "echo 'Releases are published by CI only (Release workflow, with approval) — see RELEASING.md' && exit 1"
	},
	"devDependencies": {
		"@astrojs/language-server": "^2.17.2",
		"@biomejs/biome": "^2.5.15",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"jszip": "3.10.2",
		"playwright": "^1.64.1",
		"pptxgenjs": "^4.0.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"zod": "^4.6.7"
	},
	"dependencies": {
		"astro": "^7.4.0"
	}
}

{
	"name": "@astlide/core",
	"version": "2.8.0",
	"description": "Slides that live in your Astro site: an Astro integration for MDX / Markdown / HTML presentations — many decks per site, presenter view, PDF and editable PowerPoint (PPTX) export in your own template, PPTX / Google Slides import",
	"type": "module",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./plugin": "./src/plugin.ts",
		"./loader": "./src/loader.ts",
		"./pptx": "./src/pptx/index.ts",
		"./mcp": "./src/mcp/index.ts",
		"./embed": "./src/embed/index.ts",
		"./embed/react": "./src/embed/react.ts",
		"./embed/vue": "./src/embed/vue.ts",
		"./context": "./src/context.ts",
		"./schema": "./src/schema.ts",
		"./components/*": "./src/components/*",
		"./internal/*.astro": "./src/internal/*.astro",
		"./internal/*.ts": "./src/internal/*.ts",
		"./internal/*": "./src/internal/*.ts",
		"./styles/*": "./src/styles/*",
		"./utils/*.ts": "./src/utils/*.ts",
		"./utils/*": "./src/utils/*.ts"
	},
	"bin": {
		"astlide": "./src/cli/astlide.ts"
	},
	"files": [
		"src",
		"CHANGELOG.md"
	],
	"scripts": {
		"docs": "node --import ../../scripts/use-typescript6.mjs ../../node_modules/typedoc/bin/typedoc",
		"prepublishOnly": "echo '✓ @astlide/core ready to publish (source-only package)'"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/r-hashi01/astlide.git",
		"directory": "packages/astlide"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"sideEffects": [
		"*.css",
		"*.astro",
		"./src/embed/*.ts"
	],
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://astlide.dev/",
	"bugs": "https://github.com/r-hashi01/astlide/issues",
	"peerDependencies": {
		"astro": "^7.2.10",
		"react": ">=18",
		"vue": ">=3.3"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"dependencies": {
		"@astlide/engine": "^0.1.2",
		"@astrojs/mdx": "^8.1.0",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"dom-serializer": "^3.1.1",
		"domhandler": "^6.0.1",
		"entities": "^8.1.0",
		"htmlparser2": "^12.0.0",
		"js-yaml": "^5.5.0",
		"katex": "^0.19.0",
		"rehype-stringify": "^10.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.0.0",
		"unified": "^11.0.0",
		"zod": "^4.6.7"
	},
	"optionalDependencies": {
		"playwright": "^1.64.1",
		"@astlide/crispdf": "^0.0.1"
	},
	"keywords": [
		"astro",
		"astro-integration",
		"astro-loader",
		"tooling",
		"slides",
		"presentation",
		"slideshow",
		"deck",
		"mdx",
		"markdown",
		"pptx",
		"powerpoint",
		"google-slides",
		"pdf",
		"slidev",
		"marp"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^30.1.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typedoc": "^0.28.20",
		"vue": "^3.5.44"
	}
}

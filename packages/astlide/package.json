{
	"name": "@astlide/core",
	"version": "2.5.0",
	"description": "Slides that live in your Astro site — an Astro integration for MDX / Markdown / HTML presentations",
	"type": "module",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./plugin": "./src/plugin.ts",
		"./loader": "./src/loader.ts",
		"./pptx": "./src/pptx/index.ts",
		"./embed": "./src/embed/index.ts",
		"./embed/react": "./src/embed/react.ts",
		"./embed/vue": "./src/embed/vue.ts",
		"./context": "./src/context.ts",
		"./schema": "./src/schema.ts",
		"./components/*": "./src/components/*",
		"./internal/*": "./src/internal/*",
		"./styles/*": "./src/styles/*",
		"./utils/*": "./src/utils/*"
	},
	"bin": {
		"astlide": "./src/cli/astlide.ts"
	},
	"files": [
		"src",
		"CHANGELOG.md"
	],
	"scripts": {
		"docs": "node --import ../../scripts/use-typescript6.mjs ../../node_modules/typedoc/bin/typedoc",
		"prepublishOnly": "echo '✓ @astlide/core ready to publish (source-only package)'"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/r-hashi01/astlide.git",
		"directory": "packages/astlide"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"sideEffects": [
		"*.css",
		"*.astro",
		"./src/embed/*.ts"
	],
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://github.com/r-hashi01/astlide#readme",
	"bugs": "https://github.com/r-hashi01/astlide/issues",
	"peerDependencies": {
		"astro": "^7.2.10",
		"react": ">=18",
		"vue": ">=3.3"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"dependencies": {
		"@astlide/engine": "^0.1.0",
		"@astrojs/mdx": "^8.0.2",
		"domhandler": "^6.0.1",
		"htmlparser2": "^12.0.0",
		"js-yaml": "^5.2.1",
		"katex": "^0.19.0",
		"rehype-stringify": "^10.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.0.0",
		"unified": "^11.0.0"
	},
	"optionalDependencies": {
		"playwright": "^1.64.0",
		"@astlide/crispdf": "^0.0.1"
	},
	"keywords": [
		"astro",
		"astro-integration",
		"slides",
		"presentation",
		"mdx",
		"slidev"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^30.1.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typedoc": "^0.28.20",
		"vue": "^3.5.44"
	}
}

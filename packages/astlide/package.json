{
	"name": "@astlide/core",
	"version": "3.0.3",
	"description": "Astlide's framework-agnostic core: deck reader, slide rendering and runtime, themes, PowerPoint import / export, PDF, the astlide CLI and MCP server — used by @astlide/astro, @astlide/react, @astlide/next, @astlide/vue and @astlide/nuxt",
	"type": "module",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./plugin": "./src/plugin.ts",
		"./pptx": "./src/pptx/index.ts",
		"./render": "./src/render/index.ts",
		"./deck": "./src/deck/index.ts",
		"./deck/files": "./src/deck/files.ts",
		"./deck/pages": "./src/deck/pages.ts",
		"./deck/print-view": "./src/deck/print-view.ts",
		"./runtime": "./src/runtime/index.ts",
		"./runtime/chrome": "./src/runtime/chrome.ts",
		"./runtime/slide": "./src/runtime/slide.ts",
		"./runtime/diagrams": "./src/runtime/diagrams.ts",
		"./runtime/media": "./src/runtime/media.ts",
		"./runtime/pdf-export": "./src/runtime/pdf-export.ts",
		"./templates": "./src/templates/index.ts",
		"./mcp": "./src/mcp/index.ts",
		"./embed": "./src/embed/index.ts",
		"./embed/react": "./src/embed/react.ts",
		"./embed/vue": "./src/embed/vue.ts",
		"./engine": "./src/engine/index.ts",
		"./context": "./src/context.ts",
		"./schema": "./src/schema.ts",
		"./styles/*": "./src/styles/*",
		"./utils/base-path": "./src/utils/base-path.ts",
		"./utils/code-highlight": "./src/utils/code-highlight.ts",
		"./utils/comment-notes": "./src/utils/comment-notes.ts",
		"./utils/export-build": "./src/utils/export-build.ts",
		"./utils/markdown": "./src/utils/markdown.ts",
		"./utils/mermaid": "./src/utils/mermaid.ts",
		"./utils/network": "./src/utils/network.ts",
		"./utils/notes": "./src/utils/notes.ts",
		"./utils/pptx-assets": "./src/utils/pptx-assets.ts",
		"./utils/safe-url": "./src/utils/safe-url.ts",
		"./utils/sanitize": "./src/utils/sanitize.ts",
		"./utils/slide-scripts": "./src/utils/slide-scripts.ts",
		"./utils/slide-title": "./src/utils/slide-title.ts"
	},
	"bin": {
		"astlide": "./src/cli/astlide.ts"
	},
	"files": [
		"src",
		"CHANGELOG.md"
	],
	"scripts": {
		"docs": "node --import ../../scripts/use-typescript6.mjs ../../node_modules/typedoc/bin/typedoc",
		"prepublishOnly": "echo '✓ @astlide/core ready to publish (source-only package)'"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/r-hashi01/astlide.git",
		"directory": "packages/astlide"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"sideEffects": [
		"*.css",
		"./src/embed/*.ts"
	],
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://astlide.dev/",
	"bugs": "https://github.com/r-hashi01/astlide/issues",
	"peerDependencies": {
		"react": ">=18",
		"vue": ">=3.3",
		"@aws-sdk/client-s3": "^3.700.0",
		"@google-cloud/storage": "^7.0.0 || ^8.0.0",
		"@azure/storage-blob": "^12.20.0",
		"@azure/identity": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"vue": {
			"optional": true
		},
		"@aws-sdk/client-s3": {
			"optional": true
		},
		"@google-cloud/storage": {
			"optional": true
		},
		"@azure/storage-blob": {
			"optional": true
		},
		"@azure/identity": {
			"optional": true
		}
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "^0.4.5",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@resvg/resvg-js": "^2.6.2",
		"css-select": "^7.0.0",
		"css-what": "^8.0.0",
		"dom-serializer": "^3.1.1",
		"domhandler": "^6.0.1",
		"entities": "^8.1.0",
		"fontkit": "^2.0.4",
		"htmlparser2": "^12.0.0",
		"js-yaml": "^5.5.0",
		"jsdom": "^30.1.3",
		"katex": "^0.19.1",
		"parse5": "^8.0.1",
		"postcss": "^8.5.31",
		"rehype-stringify": "^10.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.0.0",
		"satteri": "^0.10.5",
		"svgdom": "^0.1.29",
		"unified": "^11.0.0",
		"yoga-layout": "^3.2.1",
		"zod": "^4.6.7"
	},
	"optionalDependencies": {
		"playwright": "^1.64.1",
		"@astlide/crispdf": "^0.0.1"
	},
	"keywords": [
		"tooling",
		"slides",
		"presentation",
		"slideshow",
		"deck",
		"mdx",
		"markdown",
		"pptx",
		"powerpoint",
		"google-slides",
		"pdf",
		"slidev",
		"marp"
	],
	"license": "MIT",
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1159.0",
		"@azure/identity": "^4.14.0",
		"@azure/storage-blob": "^12.34.0",
		"@google-cloud/storage": "^8.4.0",
		"@types/fontkit": "^2.0.9",
		"@types/jsdom": "^30.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typedoc": "^0.28.20",
		"vue": "^3.5.44"
	}
}

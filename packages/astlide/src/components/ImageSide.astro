---
import '@astlide/core/styles/components.css';
/**
 * ImageSide — used inside image-left / image-right layouts.
 *
 * Usage:
 *   <ImageSide src="/photo.jpg" alt="Photo" />
 *   (root-relative `src` is resolved against Astro's `base`)
 *   Then put text content after it — Slide handles the flex layout.
 *
 * Or use <Left> / <Right> for full manual control.
 */
import { withBaseIfRootRelative } from '@astlide/core/utils/base-path';

interface Props {
  src: string;
  alt?: string;
  width?: string;
  class?: string;
}

const { src: rawSrc, alt = '', width = '50%', class: className } = Astro.props;
// Root-relative paths ("/photo.jpg") resolve against Astro's `base`.
const src = withBaseIfRootRelative(rawSrc);
---

<div class:list={['image-side', className]} data-astlide-c style={`width: ${width}; flex-shrink: 0;`}>
  <img src={src} alt={alt} />
</div>

---
import '@astlide/core/styles/base.css';
// All theme CSS is registered through the Astlide plugin API and emitted as side-effect
// imports by the `virtual:astlide/themes` Vite virtual module.
import 'virtual:astlide/themes';
import { ClientRouter } from 'astro:transitions';
import Favicon from '@astlide/core/internal/Favicon.astro';
import { sanitizeHTML } from '@astlide/core/utils/sanitize';
import { renderMarkdown } from '@astlide/core/utils/markdown';
import { basePath, withBase } from '@astlide/core/utils/base-path';

// Vite defines injected by the astlide() integration
declare const __ASTLIDE_CSP__: boolean | string;
declare const __ASTLIDE_INDEXABLE__: boolean;
declare const __ASTLIDE_TOOLBAR__: string[];
declare const __ASTLIDE_FONT__: { href: string; preconnect: string[] } | null;
declare const __ASTLIDE_DRAWINGS_PERSIST__: boolean;

const persistDrawings: boolean =
  typeof __ASTLIDE_DRAWINGS_PERSIST__ !== 'undefined' ? __ASTLIDE_DRAWINGS_PERSIST__ : false;
const toolbarItems: string[] =
  typeof __ASTLIDE_TOOLBAR__ !== 'undefined' && Array.isArray(__ASTLIDE_TOOLBAR__)
    ? __ASTLIDE_TOOLBAR__
    : ['prev', 'counter', 'next'];
const fontConfig: { href: string; preconnect: string[] } | null =
  typeof __ASTLIDE_FONT__ !== 'undefined'
    ? __ASTLIDE_FONT__
    : {
        href: 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap',
        preconnect: ['https://fonts.googleapis.com', 'https://fonts.gstatic.com'],
      };

const DEFAULT_CSP = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "font-src 'self' https://fonts.gstatic.com data:",
  "img-src 'self' data: https: blob:",
  // `data:` and `blob:` allowed so the in-browser PDF exporter can fetch
  // its own rasterised page images while assembling the document.
  "connect-src 'self' data: blob:",
  "frame-src 'self' https://www.youtube-nocookie.com",
].join('; ');

const cspOption: boolean | string =
  typeof __ASTLIDE_CSP__ !== 'undefined' ? __ASTLIDE_CSP__ : true;
// Dev only: let Vite's client run its reconnect worker (see utils/csp).
const cspContent =
  cspOption === false ? null
  : withDevDirectives(
      typeof cspOption === 'string' && cspOption !== 'true' ? cspOption : DEFAULT_CSP,
      import.meta.env.DEV,
    );

import type { DeckContext } from '@astlide/core/context';
import { withDevDirectives } from '@astlide/core/utils/csp';

interface Props {
  title: string;
  theme?: string;
  currentSlide: number;
  totalSlides: number;
  deck: string;
  notes?: string;
  transition?: string;
  /** Typed deck/slide metadata published to `window.__astlide` for client scripts. */
  context?: DeckContext;
  /** Slide numbers and titles for the go-to-slide dialog (`g`). */
  outline?: Array<{ n: number; title: string }>;
  /** Dev only: project-relative source file of this slide, for the `e` editor. */
  sourcePath?: string;
  /** Dev only: the deck's source files in slide order (live updates on add/remove). */
  deckSources?: string[];
  /**
   * Neighbouring and first / last slides to navigate to. In production these
   * skip hidden slides (which only redirect); default: the adjacent numbers.
   */
  prevSlide?: number | null;
  nextSlide?: number | null;
  firstSlide?: number;
  lastSlide?: number;
}

const { title, theme = 'default', currentSlide, totalSlides, deck, notes, transition = 'fade', context, outline = [], sourcePath, deckSources } = Astro.props;
const {
  prevSlide = currentSlide > 1 ? currentSlide - 1 : null,
  nextSlide = currentSlide < totalSlides ? currentSlide + 1 : null,
  firstSlide = 1,
  lastSlide = totalSlides,
} = Astro.props;
const sanitizedNotes = notes ? sanitizeHTML(await renderMarkdown(notes)) : undefined;
// Internal links honour Astro's `base` (sub-path deployments).
const deckHref = withBase(`/${deck}`);
const progress = (currentSlide / totalSlides) * 100;
const indexable = typeof __ASTLIDE_INDEXABLE__ !== 'undefined' ? __ASTLIDE_INDEXABLE__ : false;
---

<!DOCTYPE html>
<html lang="en" data-theme={theme} data-slide-transition={transition}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {cspContent && <meta http-equiv="Content-Security-Policy" content={cspContent} />}
    <title>{title}</title>
    <Favicon />
    <meta name="description" content={`${title} — slide ${currentSlide} of ${totalSlides}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={`Slide deck: ${title}`} />
    <meta property="og:type" content="website" />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {nextSlide && <link rel="prefetch" href={`${deckHref}/${nextSlide}`} />}
    {fontConfig?.preconnect?.map((origin) => (
      <link rel="preconnect" href={origin} crossorigin={origin.includes('gstatic') ? '' : undefined} />
    ))}
    {fontConfig?.href && <link href={fontConfig.href} rel="stylesheet" />}
    <ClientRouter />
    <script is:inline>
      (function () {
        // A-4: in the dedicated presenter popup (window.name === 'astlide-presenter'),
        // treat the window as sticky-presenter so transient ?presenter query drops
        // during ClientRouter swaps don't kick the popup back to normal mode.
        function isStickyPresenter() {
          try { return window.name === 'astlide-presenter'; } catch (_) { return false; }
        }
        function applyFlags(doc, search) {
          var p = new URLSearchParams(search);
          doc.documentElement.toggleAttribute('data-presenter', p.has('presenter') || isStickyPresenter());
          doc.documentElement.toggleAttribute('data-print', p.has('print'));
          doc.documentElement.toggleAttribute('data-share', p.has('share'));
          // Rendered inside an iframe (overview thumbnails, presenter next-slide
          // preview): hide chrome and skip navigation/sync — see isEmbedded below.
          doc.documentElement.toggleAttribute('data-embed', window.self !== window.top);
        }
        applyFlags(document, location.search);
        if (!window.__astlide_swap_listeners__) {
          window.__astlide_swap_listeners__ = true;
          document.addEventListener('astro:before-swap', function (e) {
            // Set flags on the new document BEFORE the swap renders, avoiding a flash (A-1, A-2).
            applyFlags(e.newDocument, new URL(e.to, location.origin).search);
          });
          document.addEventListener('astro:after-swap', function () {
            applyFlags(document, location.search);
          });
        }
      })();
    </script>
  </head>
  <body data-total-slides={totalSlides} data-current-slide={currentSlide} data-deck={deck} data-slide-transition={transition} data-source-path={sourcePath} data-deck-sources={deckSources && JSON.stringify(deckSources)}>

    <!-- Skip link for keyboard navigation -->
    <a href="#slide-scaler" class="skip-link">Skip to slide content</a>

    <!-- aria-live region for screen reader announcements -->
    <div class="sr-only" aria-live="polite" aria-atomic="true" id="slide-announcer">
      {`Slide ${currentSlide} of ${totalSlides}`}
    </div>

    <!-- Progress bar -->
    <div class="progress-bar" style={`width: ${progress}%`} role="progressbar" aria-valuenow={currentSlide} aria-valuemin={1} aria-valuemax={totalSlides} aria-label={`Slide progress: ${currentSlide} of ${totalSlides}`}></div>

    <!-- Presenter mode layout (hidden by default; shown via CSS when html[data-presenter]) -->
    <div class="presenter-layout">
      <div class="presenter-slide-area">
        <div class="presenter-current">
          <!-- #slide-scaler moved here by JS when in presenter mode -->
        </div>
      </div>
      <aside class="presenter-panel" aria-label="Presenter controls">
        <div class="presenter-info">
          <span class="presenter-counter">{currentSlide} / {totalSlides}</span>
          <div class="timer-wrapper">
            <span class="presenter-timer" id="presenter-timer">00:00</span>
            <button class="timer-btn" id="timer-btn" type="button" aria-label="Start timer" title="Start timer">▶</button>
            <button class="timer-reset-btn" id="timer-reset" type="button" aria-label="Reset timer" title="Reset timer">↺</button>
          </div>
        </div>
        <section class="presenter-next" aria-label="Next slide">
          <div class="presenter-section-header">
            <h3>Next</h3>
            <span class="presenter-steps-left" id="presenter-steps-left" hidden></span>
          </div>
          {nextSlide
            ? <div class="presenter-next-frame" data-next-src={`${deckHref}/${nextSlide}`}></div>
            : <p class="presenter-next-end">End of deck</p>
          }
        </section>
        <div class="presenter-notes">
          <div class="presenter-notes-header">
            <h3>Notes</h3>
            <div class="notes-font-controls" role="group" aria-label="Adjust notes font size">
              <button type="button" class="notes-font-btn" data-notes-font="dec" aria-label="Decrease notes font size" title="Smaller (Shift+,)">A−</button>
              <button type="button" class="notes-font-btn" data-notes-font="reset" aria-label="Reset notes font size" title="Reset">A</button>
              <button type="button" class="notes-font-btn" data-notes-font="inc" aria-label="Increase notes font size" title="Larger (Shift+.)">A+</button>
            </div>
          </div>
          {sanitizedNotes
            ? <div class="notes-content" set:html={sanitizedNotes} />
            : <p class="no-notes">No notes for this slide.</p>
          }
        </div>
        <div class="presenter-nav">
          <a href={prevSlide ? `${deckHref}/${prevSlide}?presenter` : undefined}
             class:list={['pnav-btn', { disabled: !prevSlide }]}
             aria-disabled={!prevSlide ? 'true' : undefined}
             tabindex={!prevSlide ? -1 : undefined}>← Prev</a>
          <a href={nextSlide ? `${deckHref}/${nextSlide}?presenter` : undefined}
             class:list={['pnav-btn', { disabled: !nextSlide }]}
             aria-disabled={!nextSlide ? 'true' : undefined}
             tabindex={!nextSlide ? -1 : undefined}>Next →</a>
        </div>
      </aside>
    </div>

    <!-- Normal presentation layout (always rendered with slot) -->
    <div class="presentation" role="main" aria-label="Slide presentation">
      <div class="slide-scaler" id="slide-scaler" tabindex="-1" transition:name="slide-content" transition:animate="none">
        <slot />
        <!-- Pen / laser overlays, in slide coordinates (scale with the slide) -->
        <canvas class="draw-layer" id="draw-layer" aria-hidden="true"></canvas>
        <div class="laser-dot" id="laser-dot" aria-hidden="true" hidden></div>
      </div>
    </div>

    <!-- Dev editor (e) host: persisted so live refreshes don't interrupt typing. -->
    {import.meta.env.DEV && <div id="astlide-editor-host" transition:persist="astlide-editor-host"></div>}

    <!-- Camera bubble (v). transition:persist keeps the live stream across slides. -->
    <div id="astlide-camera" class="camera-bubble" transition:persist="astlide-camera" aria-label="Camera" hidden>
      <video autoplay muted playsinline></video>
    </div>

    <!-- Recording indicator (r) -->
    <div class="recording-indicator" role="status" aria-label="Recording">
      <span class="recording-dot" aria-hidden="true"></span>
      <span id="astlide-recording-time">0:00</span>
    </div>

    <!-- Navigation (hidden until hover; hidden in presenter mode via CSS) -->
    <nav class="slide-nav" aria-label="Slide navigation">
      {toolbarItems.map((item) => {
        if (item === 'home') return (
          <a href={withBase('/')}
             class="nav-btn nav-action"
             aria-label="Back to deck index"
             title="Back to deck index">⌂</a>
        );
        if (item === 'prev') return (
          <a href={prevSlide ? `${deckHref}/${prevSlide}` : undefined}
             class:list={['nav-btn', { disabled: !prevSlide }]}
             aria-label="Previous slide"
             aria-disabled={!prevSlide ? 'true' : undefined}
             tabindex={!prevSlide ? -1 : undefined}>←</a>
        );
        if (item === 'next') return (
          <a href={nextSlide ? `${deckHref}/${nextSlide}` : undefined}
             class:list={['nav-btn', { disabled: !nextSlide }]}
             aria-label="Next slide"
             aria-disabled={!nextSlide ? 'true' : undefined}
             tabindex={!nextSlide ? -1 : undefined}>→</a>
        );
        if (item === 'counter') return (
          <span class="nav-indicator">{currentSlide} / {totalSlides}</span>
        );
        if (item === 'notes') return (
          <button type="button" class="nav-btn nav-action" data-action="notes" aria-label="Toggle speaker notes" title="Toggle speaker notes (n)">📝</button>
        );
        if (item === 'goto') return (
          <button type="button" class="nav-btn nav-action" data-action="goto" aria-label="Go to slide" title="Go to slide (g)">⌕</button>
        );
        if (item === 'draw') return (
          <button type="button" class="nav-btn nav-action" data-action="draw" aria-label="Toggle drawing" aria-pressed="false" title="Draw on the slide (d) — c clears">✎</button>
        );
        if (item === 'laser') return (
          <button type="button" class="nav-btn nav-action" data-action="laser" aria-label="Toggle laser pointer" aria-pressed="false" title="Laser pointer (l)">◉</button>
        );
        if (item === 'camera') return (
          <button type="button" class="nav-btn nav-action" data-action="camera" aria-label="Toggle camera" aria-pressed="false" title="Camera (v)">◎</button>
        );
        if (item === 'record') return (
          <button type="button" class="nav-btn nav-action" data-action="record" aria-label="Record the talk" aria-pressed="false" title="Record (r)">⏺</button>
        );
        if (item === 'overview') return (
          <button type="button" class="nav-btn nav-action" data-action="overview" aria-label="Open slide overview" title="Slide overview (o)">▦</button>
        );
        if (item === 'presenter') return (
          <button type="button" class="nav-btn nav-action" data-action="presenter" aria-label="Open presenter window" title="Open presenter window (p)">🎤</button>
        );
        if (item === 'fullscreen') return (
          <button type="button" class="nav-btn nav-action" data-action="fullscreen" aria-label="Toggle fullscreen" title="Toggle fullscreen (f)">⛶</button>
        );
        if (item === 'print') return (
          <button type="button" class="nav-btn nav-action" data-action="print" aria-label="Toggle print mode" title="Toggle print mode">🖨</button>
        );
        if (item === 'share') return (
          <button type="button" class="nav-btn nav-action" data-action="share" aria-label="Toggle share mode" title="Toggle share mode (clean canvas)">📺</button>
        );
        if (item === 'download') return (
          <button type="button" class="nav-btn nav-action" data-action="download" aria-label="Download deck as PDF" title="Download deck as PDF">⬇</button>
        );
        if (item === 'spacer') return <span class="nav-spacer" aria-hidden="true"></span>;
        return null;
      })}
    </nav>

    <!-- Notes overlay (toggled with 'n'; hidden in presenter mode via CSS) -->
    <div class="notes-overlay" id="notes-overlay" role="complementary" aria-label="Speaker notes" aria-hidden="true">
      <div class="notes-overlay-content">
        <div class="notes-overlay-header">
          <span>Speaker Notes</span>
          <button class="notes-close" id="notes-close" aria-label="Close speaker notes">✕</button>
        </div>
        {sanitizedNotes
          ? <div class="notes-body" set:html={sanitizedNotes} />
          : <div class="notes-body"><p class="no-notes">No notes for this slide.</p></div>
        }
      </div>
    </div>

    <!-- PDF download progress overlay -->
    <div class="pdf-overlay" id="pdf-overlay" role="dialog" aria-label="Generating PDF" aria-hidden="true">
      <div class="pdf-overlay-card">
        <div class="pdf-overlay-title">Generating PDF</div>
        <div class="pdf-overlay-progress">
          <div class="pdf-overlay-bar" id="pdf-overlay-bar" style="width: 0%"></div>
        </div>
        <div class="pdf-overlay-status" id="pdf-overlay-status">Preparing…</div>
      </div>
    </div>

    <!-- Overview mode overlay -->
    <div class="overview" id="overview" role="dialog" aria-label="Slide overview" aria-hidden="true">
      <div class="overview-header">
        Overview — press <kbd>o</kbd> or <kbd>Esc</kbd> to close
      </div>
      <div class="overview-grid" id="overview-grid" role="list"></div>
    </div>

    <!-- Go-to-slide dialog (g): filter by number or title, Enter to jump -->
    <div class="goto" id="goto" role="dialog" aria-modal="true" aria-label="Go to slide" aria-hidden="true">
      <div class="goto-card">
        <input
          class="goto-input"
          id="goto-input"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="Go to slide — number or title"
          role="combobox"
          aria-expanded="true"
          aria-controls="goto-list"
          aria-autocomplete="list"
        />
        <ul class="goto-list" id="goto-list" role="listbox" aria-label="Slides"></ul>
      </div>
    </div>

    <!-- Module script: expose Astro navigate() for ClientRouter -->
    <script>
      import { navigate } from 'astro:transitions/client';
      window.__astlide_navigate = navigate;
    </script>

    <!-- Module script: camera bubble + recording (state survives navigations). -->
    <script>
      import { toggleCamera, toggleRecording, syncMediaUi } from '@astlide/core/internal/recording';
      window.__astlide_media = {
        toggleCamera,
        toggleRecording: () => toggleRecording((window.__astlide && window.__astlide.deck) || 'astlide'),
      };
      document.addEventListener('astro:page-load', syncMediaUi);
    </script>

    <!-- Module script: dev-only slide editor (e). Tree-shaken from production builds. -->
    <script>
      if (import.meta.env.DEV) {
        import('@astlide/core/internal/editor').then(({ toggleEditor, initEditor }) => {
          window.__astlide_editor = { toggle: () => toggleEditor() };
          initEditor();
          document.addEventListener('astro:page-load', initEditor);
        });
      }
    </script>

    <!-- Module script: render ```mermaid diagrams (loads mermaid only when a slide has one). -->
    <script>
      import { renderDiagrams } from '@astlide/core/internal/diagrams';
      // Fires on the first load and after every ClientRouter navigation.
      document.addEventListener('astro:page-load', () => { renderDiagrams(); });
    </script>

    <!-- Module script: lazy-load the PDF export pipeline on demand. -->
    <script>
      window.__astlide_download_pdf = async function (opts) {
        const mod = await import('@astlide/core/internal/pdf-export');
        const result = await mod.exportDeckToPdf(opts);
        mod.downloadBlob(result.blob, opts.deck + '.pdf');
        return result;
      };
    </script>

    <!-- data-astro-rerun: ClientRouter skips inline scripts whose text already ran.
         This script embeds per-slide values, so without it, returning to a
         previously visited slide would keep the last slide's state (e.g. →
         from a revisited slide 2 after visiting 3 jumped to 4). -->
    <script data-astro-rerun define:vars={{ currentSlide, totalSlides, prevSlide, nextSlide, firstSlide, lastSlide, deck, deckContext: context ?? null, outline, basePath, persistDrawings }}>
      // ── 0. Publish typed deck/slide metadata for client scripts ──
      // Replaces parsing document.title / body.dataset. See @astlide/core/context.
      if (deckContext) window.__astlide = deckContext;

      // ── 0. Presenter mode (detected from live URL, works for SSG) ─
      const isPresenter = document.documentElement.hasAttribute('data-presenter');
      // Inside an iframe (overview thumbnail / presenter next-slide preview) the page
      // only renders: no focus grab, keyboard/touch navigation or presenter sync —
      // otherwise a thumbnail would follow the presenter's navigation broadcasts.
      const isEmbedded = document.documentElement.hasAttribute('data-embed');

      // Encode deck name for safe URL construction (SSG value, but encode defensively
      // to prevent open-redirect if the deck directory name contains special characters).
      const deckPath = encodeURIComponent(deck);
      // URL prefix for this deck's slides, including Astro's `base` (sub-path deploys).
      const deckUrl = basePath + '/' + deckPath;

      // ── 1. Cleanup from previous page (ClientRouter) ─────────
      if (window.__astlide_cleanup) {
        try { window.__astlide_cleanup(); } catch(e) { /* ignore */ }
      }

      // ── 2. Navigation helper (uses ClientRouter if available) ─
      function navTo(url) {
        if (window.__astlide_navigate) {
          window.__astlide_navigate(url);
        } else {
          window.location.href = url;
        }
      }

      // ── 3. Viewport scaling ────────────────────────────────────
      const scaler = document.getElementById('slide-scaler');
      const slideEl = scaler ? scaler.querySelector('.slide') : null;

      // Move slide content into presenter area if in presenter mode
      if (isPresenter && scaler) {
        const presenterCurrent = document.querySelector('.presenter-current');
        if (presenterCurrent) presenterCurrent.appendChild(scaler);
      }

      function updateScale() {
        if (!slideEl || !scaler) return;
        const rootStyle = getComputedStyle(document.documentElement);
        const rawW = rootStyle.getPropertyValue('--slide-width').trim();
        const rawH = rootStyle.getPropertyValue('--slide-height').trim();
        const slideW = parseFloat(rawW) || 1920;
        const slideH = parseFloat(rawH) || 1080;

        let availW, availH;
        if (isPresenter) {
          const area = document.querySelector('.presenter-current');
          availW = area ? area.clientWidth : window.innerWidth * 0.65;
          availH = area ? area.clientHeight : window.innerHeight;
        } else {
          // The dev editor (e) docks on the right and reserves its width here.
          const reserved = document.documentElement.hasAttribute('data-editor')
            ? (document.querySelector('.astlide-editor')?.getBoundingClientRect().width || 0)
            : 0;
          availW = window.innerWidth - reserved;
          availH = window.innerHeight;
        }

        const scale = Math.min(availW / slideW, availH / slideH);
        scaler.style.width = slideW + 'px';
        scaler.style.height = slideH + 'px';
        scaler.style.transform = 'scale(' + scale + ')';
      }

      updateScale();
      window.addEventListener('resize', updateScale);

      // Focus management: move focus to slide content on page load
      // Not while the dev editor is open: a live refresh must leave focus (and the
      // caret) in the editor.
      if (scaler && !isPresenter && !isEmbedded && !document.documentElement.hasAttribute('data-editor')) {
        scaler.focus({ preventScroll: true });
      }

      // ── 3. Steps: <Fragment> reveals + code highlight steps ─────
      // Everything that changes on → is collected as an *event* with run()/undo().
      // Events are ordered by step number (data-fragment-index; unindexed = 0),
      // ties keep document order. Consecutive events with the same explicit
      // index form one step, so fragments sharing an index reveal together.
      function readIndex(el, attr) {
        const raw = el.getAttribute(attr);
        if (raw === null || raw === '') return null;
        const i = parseInt(raw, 10);
        return Number.isNaN(i) ? null : i;
      }

      // Code fences with `{2|3-5|all}` carry data-code-steps="2|3,4,5|*" (see
      // utils/code-highlight.ts). Segment 0 is the initial state rendered at build
      // time; each later segment becomes one event.
      function applyCodeSegment(pre, segment) {
        const lines = segment === '*' ? null : new Set(segment.split(',').filter(Boolean));
        for (const line of pre.querySelectorAll('.line[data-line]')) {
          line.classList.toggle('highlighted', !lines || lines.has(line.getAttribute('data-line')));
        }
      }

      function setFragmentVisible(el, visible) {
        if (visible) el.setAttribute('data-fragment-visible', 'true');
        else el.removeAttribute('data-fragment-visible');
        el.setAttribute('aria-hidden', visible ? 'false' : 'true');
      }

      let events = [];
      let steps = [];

      // Collect steps from the DOM, every fragment / code block in its initial
      // state. Re-run by the dev editor after it patches slide content in place.
      function buildSteps() {
        // <Fragments>: every first-level list item (or direct child) becomes an
        // unindexed fragment with the group's effect.
        for (const group of document.querySelectorAll('[data-fragment-group]')) {
          const listItems = group.querySelectorAll(':scope > ul > li, :scope > ol > li');
          const items = listItems.length > 0 ? listItems : group.children;
          for (const item of items) {
            item.setAttribute('data-fragment', '');
            item.setAttribute('data-fragment-effect', group.getAttribute('data-fragment-group') || 'fade');
          }
          group.setAttribute('data-fragment-group-ready', '');
        }

        events = [];
        let eventSeq = 0;
        function addEvent(index, run, undo) {
          events.push({ order: index ?? 0, group: index === null ? null : index, seq: eventSeq++, run, undo });
        }

        for (const el of document.querySelectorAll('[data-fragment], pre[data-code-steps]')) {
          const index = readIndex(el, 'data-fragment-index');
          if (el.hasAttribute('data-fragment')) {
            // Fragment.astro omits static aria-hidden so screen readers can access
            // content when JS is unavailable (CSS hides it visually). With JS running,
            // we manage aria-hidden here to match the visual reveal state.
            if (el.hasAttribute('data-fragment-hide')) {
              setFragmentVisible(el, true);
              addEvent(index, () => setFragmentVisible(el, false), () => setFragmentVisible(el, true));
            } else {
              setFragmentVisible(el, false);
              addEvent(index, () => setFragmentVisible(el, true), () => setFragmentVisible(el, false));
              const until = readIndex(el, 'data-fragment-until');
              if (until !== null) {
                addEvent(until, () => setFragmentVisible(el, false), () => setFragmentVisible(el, true));
              }
            }
          } else {
            const segments = el.getAttribute('data-code-steps').split('|');
            applyCodeSegment(el, segments[0]);
            for (let i = 1; i < segments.length; i++) {
              addEvent(index, () => applyCodeSegment(el, segments[i]), () => applyCodeSegment(el, segments[i - 1]));
            }
          }
        }
        events.sort((a, b) => a.order - b.order || a.seq - b.seq);

        steps = [];
        for (const event of events) {
          const last = steps[steps.length - 1];
          if (last && event.group !== null && last.group === event.group) last.events.push(event);
          else steps.push({ group: event.group, events: [event] });
        }
      }
      buildSteps();

      let currentStep = -1;

      // Presenter panel: "+N steps" next to the next-slide preview, so the speaker
      // knows whether → reveals more on this slide or moves on.
      const stepsLeftEl = document.getElementById('presenter-steps-left');
      function updateStepsLeft() {
        // Exposed so the dev editor can keep the step across live refreshes.
        window.__astlide_step = { slide: currentSlide, step: currentStep };
        if (!stepsLeftEl) return;
        const left = steps.length - 1 - currentStep;
        stepsLeftEl.hidden = left <= 0;
        stepsLeftEl.textContent = '+' + left + (left === 1 ? ' step' : ' steps');
      }
      updateStepsLeft();

      function showNextStep() {
        if (currentStep < steps.length - 1) {
          currentStep++;
          for (const event of steps[currentStep].events) event.run();
          updateStepsLeft();
          return true;
        }
        return false;
      }

      function showPrevStep() {
        if (currentStep >= 0) {
          const { events: stepEvents } = steps[currentStep];
          for (let i = stepEvents.length - 1; i >= 0; i--) stepEvents[i].undo();
          currentStep--;
          updateStepsLeft();
          return true;
        }
        return false;
      }

      // Jump to a given step (used to mirror the other window's position).
      function goToStep(target) {
        const clamped = Math.max(-1, Math.min(target, steps.length - 1));
        while (currentStep < clamped) showNextStep();
        while (currentStep > clamped) showPrevStep();
      }

      // Dev editor: after slide content is patched in place, rebuild the steps
      // from the new DOM and return to the same step.
      window.__astlide_resync_steps = function () {
        const target = currentStep;
        buildSteps();
        currentStep = -1;
        goToStep(target);
        updateStepsLeft();
      };

      // Next-slide preview: only the presenter window loads the iframe, so the
      // audience view never fetches an extra page. The embedded page scales itself
      // to the iframe's viewport (see updateScale / isEmbedded).
      if (isPresenter && !isEmbedded) {
        const nextFrame = document.querySelector('.presenter-next-frame');
        const nextSrc = nextFrame && nextFrame.getAttribute('data-next-src');
        if (nextFrame && nextSrc && !nextFrame.querySelector('iframe')) {
          const iframe = document.createElement('iframe');
          iframe.src = nextSrc;
          iframe.title = 'Next slide preview';
          iframe.setAttribute('scrolling', 'no');
          iframe.tabIndex = -1;
          nextFrame.appendChild(iframe);
        }
      }

      // ── 4. Presenter sync (BroadcastChannel with fallback) ────
      let syncChannel = null;
      try {
        if (!isEmbedded && typeof BroadcastChannel !== 'undefined') {
          syncChannel = new BroadcastChannel('astlide-sync-' + deck);
          syncChannel.onmessage = function(e) {
            const data = e.data;
            if (data && data.type === 'navigate' && data.slide !== currentSlide) {
              navTo(deckUrl + '/' + data.slide + (isPresenter ? '?presenter' : ''));
            } else if (data && data.type === 'step') {
              // Mirror fragment / code-step progress. A step for another slide
              // usually means we are still navigating there: keep it for the next
              // page to apply once its steps exist.
              if (data.slide === currentSlide) goToStep(data.step);
              else window.__astlide_pending_step = data;
            } else if (data && (data.type === 'draw' || data.type === 'draw-clear' || data.type === 'draw-clear-all' || data.type === 'laser' || data.type === 'laser-off')) {
              receiveDrawing(data);
            }
          };
        }
      } catch (_) {
        // BroadcastChannel not available — each window navigates independently
        syncChannel = null;
      }

      function broadcastSlide(slideNum) {
        if (syncChannel) {
          try { syncChannel.postMessage({ type: 'navigate', slide: slideNum }); }
          catch (_) { /* ignore */ }
        }
      }

      function postSync(message) {
        if (syncChannel) {
          try { syncChannel.postMessage(message); }
          catch (_) { /* ignore */ }
        }
      }
      
      function broadcastStep() {
        if (syncChannel) {
          try { syncChannel.postMessage({ type: 'step', slide: currentSlide, step: currentStep }); }
          catch (_) { /* ignore */ }
        }
      }

      // Apply a step that arrived while this page was still loading.
      const pendingStep = window.__astlide_pending_step;
      window.__astlide_pending_step = null;
      if (pendingStep && pendingStep.slide === currentSlide) goToStep(pendingStep.step);

      // ── 4b. Broadcast on link click (A-3) ──────────────────────
      // Nav buttons and presenter-panel buttons navigate via <a href>, bypassing
      // goNext()/goPrev(). Capture clicks on those links to keep the sibling
      // window in sync.
      function handleNavClick(e) {
        const a = e.target.closest && e.target.closest('a.nav-btn, a.pnav-btn');
        if (!a || a.classList.contains('disabled')) return;
        const href = a.getAttribute('href');
        if (!href) return;
        const m = href.match(/\/([^/?#]+)\/(\d+)(?:[?#]|$)/);
        if (!m) return;
        const targetDeck = decodeURIComponent(m[1]);
        const targetSlide = parseInt(m[2], 10);
        if (targetDeck !== deck || Number.isNaN(targetSlide)) return;
        broadcastSlide(targetSlide);
      }
      document.addEventListener('click', handleNavClick, true);

      // ── 5. Navigation ──────────────────────────────────────────
      function goNext() {
        if (showNextStep()) { broadcastStep(); return; }
        // nextSlide / prevSlide skip hidden slides in production.
        if (nextSlide) {
          broadcastSlide(nextSlide);
          navTo(deckUrl + '/' + nextSlide + (isPresenter ? '?presenter' : ''));
        }
      }

      function goPrev() {
        if (showPrevStep()) { broadcastStep(); return; }
        if (prevSlide) {
          broadcastSlide(prevSlide);
          navTo(deckUrl + '/' + prevSlide + (isPresenter ? '?presenter' : ''));
        }
      }

      // ── 6. Overview mode ───────────────────────────────────────
      const overview = document.getElementById('overview');
      const overviewGrid = document.getElementById('overview-grid');
      let overviewOpen = false;

      function openOverview() {
        if (!overview) return;
        overviewOpen = true;
        overview.setAttribute('aria-hidden', 'false');
        overview.classList.add('open');
        if (overviewGrid && overviewGrid.children.length === 0) {
          // The outline lists the slides you can visit (no hidden ones in production).
          const numbers = outline.length > 0
            ? outline.map((s) => s.n)
            : Array.from({ length: totalSlides }, (_, k) => k + 1);
          for (const i of numbers) {
            const item = document.createElement('a');
            item.href = deckUrl + '/' + i;
            item.className = 'overview-item' + (i === currentSlide ? ' current' : '');
            item.setAttribute('role', 'listitem');
            item.setAttribute('aria-label', 'Slide ' + i + ' of ' + totalSlides + (i === currentSlide ? ' (current)' : ''));

            const iframe = document.createElement('iframe');
            iframe.src = deckUrl + '/' + i;
            iframe.setAttribute('sandbox', 'allow-same-origin allow-scripts');
            iframe.setAttribute('scrolling', 'no');
            iframe.tabIndex = -1;
            iframe.setAttribute('aria-hidden', 'true');
            item.appendChild(iframe);

            const label = document.createElement('span');
            label.className = 'overview-item-label';
            label.textContent = String(i);
            item.appendChild(label);

            overviewGrid.appendChild(item);
          }
        }
      }

      function closeOverview() {
        if (!overview) return;
        overviewOpen = false;
        overview.setAttribute('aria-hidden', 'true');
        overview.classList.remove('open');
      }

      if (overview) overview.addEventListener('click', (e) => { if (e.target === overview) closeOverview(); });

      // ── 6b. Go-to-slide dialog (g) ─────────────────────────────
      const gotoEl = document.getElementById('goto');
      const gotoInput = document.getElementById('goto-input');
      const gotoList = document.getElementById('goto-list');
      let gotoOpen = false;
      let gotoMatches = [];
      let gotoActive = 0;

      function filterOutline(query) {
        const q = query.trim().toLowerCase();
        if (!q) return outline;
        const hits = outline.filter((s) => String(s.n).startsWith(q) || s.title.toLowerCase().includes(q));
        // An exact slide number always comes first.
        return hits.sort((a, b) => (String(b.n) === q) - (String(a.n) === q));
      }

      function renderGoto() {
        gotoMatches = filterOutline(gotoInput.value);
        gotoActive = Math.min(gotoActive, Math.max(gotoMatches.length - 1, 0));
        gotoList.replaceChildren(...gotoMatches.map((s, i) => {
          const li = document.createElement('li');
          li.id = 'goto-option-' + s.n;
          li.className = 'goto-option' + (s.n === currentSlide ? ' current' : '');
          li.setAttribute('role', 'option');
          li.setAttribute('aria-selected', String(i === gotoActive));
          li.dataset.slide = String(s.n);
          const num = document.createElement('span');
          num.className = 'goto-num';
          num.textContent = String(s.n);
          const label = document.createElement('span');
          label.className = 'goto-title';
          label.textContent = s.title;
          li.append(num, label);
          return li;
        }));
        const active = gotoMatches[gotoActive];
        if (active) {
          gotoInput.setAttribute('aria-activedescendant', 'goto-option-' + active.n);
          document.getElementById('goto-option-' + active.n)?.scrollIntoView({ block: 'nearest' });
        } else {
          gotoInput.removeAttribute('aria-activedescendant');
        }
      }

      function openGoto() {
        if (!gotoEl || !gotoInput || !gotoList) return;
        gotoOpen = true;
        gotoInput.value = '';
        gotoActive = Math.max(outline.findIndex((s) => s.n === currentSlide), 0);
        gotoEl.setAttribute('aria-hidden', 'false');
        gotoEl.classList.add('open');
        renderGoto();
        gotoInput.focus();
      }

      function closeGoto() {
        if (!gotoEl) return;
        gotoOpen = false;
        gotoEl.setAttribute('aria-hidden', 'true');
        gotoEl.classList.remove('open');
        if (scaler && !isPresenter) scaler.focus({ preventScroll: true });
      }

      function goToSlide(n) {
        closeGoto();
        if (n === currentSlide) return;
        broadcastSlide(n);
        navTo(deckUrl + '/' + n + (isPresenter ? '?presenter' : ''));
      }

      function handleGotoKeydown(e) {
        switch (e.key) {
          case 'ArrowDown':
            e.preventDefault();
            gotoActive = Math.min(gotoActive + 1, gotoMatches.length - 1);
            renderGoto();
            break;
          case 'ArrowUp':
            e.preventDefault();
            gotoActive = Math.max(gotoActive - 1, 0);
            renderGoto();
            break;
          case 'Enter':
            e.preventDefault();
            if (gotoMatches[gotoActive]) goToSlide(gotoMatches[gotoActive].n);
            break;
          case 'Escape':
            e.preventDefault();
            closeGoto();
            break;
        }
      }

      function handleGotoClick(e) {
        if (e.target === gotoEl) { closeGoto(); return; }
        const option = e.target.closest && e.target.closest('.goto-option');
        if (option) goToSlide(parseInt(option.dataset.slide, 10));
      }

      function handleGotoInput() {
        gotoActive = 0;
        renderGoto();
      }

      if (gotoEl && gotoInput && !isEmbedded) {
        gotoInput.addEventListener('keydown', handleGotoKeydown);
        gotoInput.addEventListener('input', handleGotoInput);
        gotoEl.addEventListener('click', handleGotoClick);
      }

      // ── 6c. Pen & laser pointer (d / l) ─────────────────────────
      // Both overlays live inside #slide-scaler in slide coordinates, so they
      // scale with the slide and line up in every window. Strokes and laser
      // positions are broadcast, so drawing in the presenter window shows on the
      // audience screen (and vice versa). Strokes are kept per slide on `window`,
      // which survives ClientRouter navigations.
      const drawLayer = document.getElementById('draw-layer');
      const laserDot = document.getElementById('laser-dot');
      const drawCtx = drawLayer && drawLayer.getContext ? drawLayer.getContext('2d') : null;
      const drawings = (window.__astlide_drawings = window.__astlide_drawings || {});
      const drawingKey = deck + '/' + currentSlide;

      // drawings.persist: keep this deck's strokes in localStorage. The key
      // includes the base path because several sites can share one origin
      // (e.g. user.github.io/<repo>). Loaded once per deck per window.
      const drawingsStorageKey = 'astlide:drawings:' + basePath + '/' + deck;
      const loadedDecks = (window.__astlide_drawings_loaded = window.__astlide_drawings_loaded || {});
      if (persistDrawings && !loadedDecks[drawingsStorageKey]) {
        loadedDecks[drawingsStorageKey] = true;
        try {
          const saved = JSON.parse(localStorage.getItem(drawingsStorageKey) || '{}');
          for (const key of Object.keys(saved)) if (!drawings[key]) drawings[key] = saved[key];
        } catch (_) { /* unavailable or corrupt storage: start empty */ }
      }
      let saveTimer = 0;
      function saveDrawings() {
        if (!persistDrawings) return;
        clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
          const deckDrawings = {};
          for (const key of Object.keys(drawings)) {
            if (key.startsWith(deck + '/') && drawings[key].length > 0) deckDrawings[key] = drawings[key];
          }
          try {
            if (Object.keys(deckDrawings).length > 0) localStorage.setItem(drawingsStorageKey, JSON.stringify(deckDrawings));
            else localStorage.removeItem(drawingsStorageKey);
          } catch (error) {
            console.warn('[astlide] Could not save drawings', error);
          }
        }, 300);
      }
      let tool = null; // 'draw' | 'laser' | null
      let activeStroke = null;
      let laserTimer = 0;

      function slideStrokes() {
        return (drawings[drawingKey] = drawings[drawingKey] || []);
      }

      function sizeDrawLayer() {
        if (!drawLayer || !scaler) return;
        const w = parseFloat(scaler.style.width) || 1920;
        const h = parseFloat(scaler.style.height) || 1080;
        if (drawLayer.width !== w || drawLayer.height !== h) {
          drawLayer.width = w;
          drawLayer.height = h;
          redrawStrokes();
        }
      }

      function drawSegment(stroke, from, to) {
        if (!drawCtx) return;
        drawCtx.strokeStyle = stroke.color;
        drawCtx.lineWidth = stroke.width;
        drawCtx.lineCap = 'round';
        drawCtx.lineJoin = 'round';
        drawCtx.beginPath();
        drawCtx.moveTo(from[0], from[1]);
        drawCtx.lineTo(to[0], to[1]);
        drawCtx.stroke();
      }

      function drawStroke(stroke) {
        const pts = stroke.points;
        if (pts.length === 1) drawSegment(stroke, pts[0], pts[0]);
        for (let i = 1; i < pts.length; i++) drawSegment(stroke, pts[i - 1], pts[i]);
      }

      function redrawStrokes() {
        if (!drawCtx || !drawLayer) return;
        drawCtx.clearRect(0, 0, drawLayer.width, drawLayer.height);
        for (const stroke of slideStrokes()) drawStroke(stroke);
      }

      // Pointer position → slide coordinates (undoes the scaler's CSS transform).
      function toSlidePoint(e) {
        const rect = drawLayer.getBoundingClientRect();
        return [
          Math.round(((e.clientX - rect.left) / rect.width) * drawLayer.width),
          Math.round(((e.clientY - rect.top) / rect.height) * drawLayer.height),
        ];
      }

      function setTool(next) {
        tool = tool === next ? null : next;
        window.__astlide_tool = tool;
        if (tool) document.documentElement.setAttribute('data-tool', tool);
        else document.documentElement.removeAttribute('data-tool');
        for (const btn of document.querySelectorAll('.nav-btn[data-action="draw"], .nav-btn[data-action="laser"]')) {
          btn.setAttribute('aria-pressed', String(btn.getAttribute('data-action') === tool));
        }
        if (tool !== 'laser') hideLaser(true);
      }

      function clearDrawings(broadcast) {
        drawings[drawingKey] = [];
        redrawStrokes();
        saveDrawings();
        if (broadcast) postSync({ type: 'draw-clear', slide: currentSlide });
      }

      // Shift+C: every slide of this deck.
      function clearDeckDrawings(broadcast) {
        for (const key of Object.keys(drawings)) {
          if (key.startsWith(deck + '/')) drawings[key] = [];
        }
        redrawStrokes();
        saveDrawings();
        if (broadcast) postSync({ type: 'draw-clear-all', slide: currentSlide });
      }

      function showLaser(point, broadcast) {
        if (!laserDot) return;
        laserDot.hidden = false;
        laserDot.style.transform = 'translate(' + point[0] + 'px, ' + point[1] + 'px)';
        clearTimeout(laserTimer);
        // Fade out remote pointers that stop updating (e.g. the window lost focus).
        if (!broadcast) laserTimer = setTimeout(() => { laserDot.hidden = true; }, 2000);
        if (broadcast) postSync({ type: 'laser', slide: currentSlide, x: point[0], y: point[1] });
      }

      function hideLaser(broadcast) {
        if (laserDot) laserDot.hidden = true;
        if (broadcast) postSync({ type: 'laser-off', slide: currentSlide });
      }

      function handleDrawPointerDown(e) {
        if (tool !== 'draw') return;
        e.preventDefault();
        try { drawLayer.setPointerCapture(e.pointerId); } catch (_) { /* keep drawing without capture */ }
        const color = getComputedStyle(document.documentElement).getPropertyValue('--astlide-pen-color').trim() || '#ef4444';
        activeStroke = { id: Date.now() + '-' + Math.random().toString(36).slice(2, 7), color, width: 6, points: [toSlidePoint(e)] };
        slideStrokes().push(activeStroke);
        drawStroke(activeStroke);
        postSync({ type: 'draw', slide: currentSlide, stroke: activeStroke });
      }

      function handleDrawPointerMove(e) {
        if (tool === 'laser') { showLaser(toSlidePoint(e), true); return; }
        if (tool !== 'draw' || !activeStroke) return;
        const point = toSlidePoint(e);
        const pts = activeStroke.points;
        drawSegment(activeStroke, pts[pts.length - 1], point);
        pts.push(point);
        postSync({ type: 'draw', slide: currentSlide, stroke: { id: activeStroke.id, color: activeStroke.color, width: activeStroke.width, points: [pts[pts.length - 2], point] } });
      }

      function handleDrawPointerUp() {
        if (activeStroke) saveDrawings();
        activeStroke = null;
      }

      function handleDrawPointerLeave() {
        if (tool === 'laser') hideLaser(true);
      }

      // Incoming pen / laser messages from the other window.
      function receiveDrawing(data) {
        if (data.type === 'draw-clear-all') { clearDeckDrawings(false); return; }
        if (data.slide !== currentSlide) return;
        if (data.type === 'laser') showLaser([data.x, data.y], false);
        else if (data.type === 'laser-off') hideLaser(false);
        else if (data.type === 'draw-clear') clearDrawings(false);
        else if (data.type === 'draw') {
          const strokes = slideStrokes();
          let stroke = strokes.find((s) => s.id === data.stroke.id);
          if (!stroke) {
            stroke = { id: data.stroke.id, color: data.stroke.color, width: data.stroke.width, points: [] };
            strokes.push(stroke);
          }
          const incoming = stroke.points.length === 0 ? data.stroke.points : data.stroke.points.slice(1);
          for (const point of incoming) {
            const last = stroke.points[stroke.points.length - 1] || point;
            drawSegment(stroke, last, point);
            stroke.points.push(point);
          }
          saveDrawings();
        }
      }

      if (drawLayer && !isEmbedded) {
        sizeDrawLayer();
        drawLayer.addEventListener('pointerdown', handleDrawPointerDown);
        drawLayer.addEventListener('pointermove', handleDrawPointerMove);
        drawLayer.addEventListener('pointerup', handleDrawPointerUp);
        drawLayer.addEventListener('pointercancel', handleDrawPointerUp);
        drawLayer.addEventListener('pointerleave', handleDrawPointerLeave);
        // Keep the tool active across slide changes.
        if (window.__astlide_tool) setTool(window.__astlide_tool);
      }

      // ── 7. <SpeakerNotes> (or <Notes>) detection ──────────────────────────
      // If <SpeakerNotes> (alias <Notes>) is used in MDX, its HTML content takes priority
      // over frontmatter `notes`. We inject it into presenter notes & notes overlay.

      /**
       * Client-side HTML sanitizer for Notes content.
       * Uses DOMParser so scripts never execute during parsing.
       *
       * Strategy mirrors the server-side sanitizeHTML() in utils/sanitize.ts:
       *   1. Remove known-dangerous tags (with content) entirely.
       *   2. Allowlist safe tags — strip any tag not in the list (promote children).
       *   3. Strip on* event-handler attributes from every remaining element.
       */
      function sanitizeNotesHTML(html) {
        const doc = new DOMParser().parseFromString(html, 'text/html');

        // 1. Remove dangerous tags entirely (mirrors server-side STRIP_WITH_CONTENT)
        const STRIP_TAGS = ['script', 'style', 'iframe', 'object', 'embed', 'form',
          'input', 'textarea', 'select', 'button', 'link', 'meta', 'base',
          'applet', 'frame', 'frameset', 'layer', 'ilayer', 'bgsound'];
        for (const tag of STRIP_TAGS) {
          doc.body.querySelectorAll(tag).forEach((el) => el.remove());
        }

        // 2. Allowlist safe tags (mirrors server-side ALLOWED_TAGS set).
        //    Process deepest elements first so nested unknown tags are safely unwrapped.
        const ALLOWED_TAGS = new Set(['b', 'i', 'em', 'strong', 'code', 'pre', 'a',
          'ul', 'ol', 'li', 'p', 'br', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
          'blockquote', 'span', 'div', 'hr', 'table', 'thead', 'tbody', 'tr',
          'th', 'td', 'dl', 'dt', 'dd', 'sup', 'sub', 'mark', 'del', 'ins',
          'kbd', 'abbr', 'small', 'details', 'summary']);
        Array.from(doc.body.querySelectorAll('*')).reverse().forEach((el) => {
          if (!ALLOWED_TAGS.has(el.tagName.toLowerCase())) {
            el.replaceWith(...Array.from(el.childNodes));
          }
        });

        // 3. Strip on* event-handler attributes from every remaining element
        doc.body.querySelectorAll('*').forEach((el) => {
          Array.from(el.attributes).forEach((attr) => {
            if (/^on\w+$/i.test(attr.name)) el.removeAttribute(attr.name);
          });
        });

        return doc.body.innerHTML;
      }

      // Also re-run by the dev editor after it patches the slide (and the
      // server-rendered notes) in place.
      function applyNotesComponent() {
        const slideNotesEl = document.querySelector('[data-slide-notes]');
        if (slideNotesEl && slideNotesEl.innerHTML.trim()) {
          const notesHTML = sanitizeNotesHTML(slideNotesEl.innerHTML);
          // Update presenter notes panel
          const presenterNotesContent = document.querySelector('.presenter-notes .notes-content');
          const presenterNoNotes = document.querySelector('.presenter-notes .no-notes');
          if (presenterNotesContent) {
            presenterNotesContent.innerHTML = notesHTML;
          } else if (presenterNoNotes) {
            const div = document.createElement('div');
            div.className = 'notes-content';
            div.innerHTML = notesHTML;
            presenterNoNotes.replaceWith(div);
          }
          // Update notes overlay body
          const notesBody = document.querySelector('.notes-body');
          if (notesBody) {
            notesBody.innerHTML = notesHTML;
          }
        }
      }
      applyNotesComponent();
      window.__astlide_resync_notes = applyNotesComponent;

      // ── 8. Notes overlay ───────────────────────────────────────
      const notesOverlay = document.getElementById('notes-overlay');
      const notesClose = document.getElementById('notes-close');
      let notesOpen = false;

      function toggleNotes() {
        if (!notesOverlay) return;
        notesOpen = !notesOpen;
        notesOverlay.setAttribute('aria-hidden', String(!notesOpen));
        notesOverlay.classList.toggle('open', notesOpen);
      }

      if (notesClose) notesClose.addEventListener('click', toggleNotes);

      // ── 8b. URL flag toggles (share / print) ───────────────────
      function toggleUrlFlag(flag) {
        const u = new URL(window.location.href);
        if (u.searchParams.has(flag)) u.searchParams.delete(flag);
        else u.searchParams.set(flag, '');
        navTo(u.pathname + (u.search ? u.search : '') + u.hash);
      }

      // ── 8c. Notes font-size controls (persisted in localStorage) ─
      function applyNotesFontSize(size) {
        const clamped = Math.max(0.7, Math.min(2.0, size));
        document.documentElement.style.setProperty('--astlide-notes-font-size', clamped + 'rem');
        try { localStorage.setItem('astlide:notes-font-size', String(clamped)); } catch (_) {}
      }
      try {
        const stored = parseFloat(localStorage.getItem('astlide:notes-font-size') || '');
        if (!Number.isNaN(stored) && stored > 0) applyNotesFontSize(stored);
      } catch (_) {}
      function adjustNotesFontSize(delta) {
        const current = parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue('--astlide-notes-font-size') || '1'
        ) || 1;
        applyNotesFontSize(current + delta);
      }
      function handleNotesFontClick(e) {
        const btn = e.target.closest && e.target.closest('[data-notes-font]');
        if (!btn) return;
        const op = btn.getAttribute('data-notes-font');
        if (op === 'inc') adjustNotesFontSize(0.1);
        else if (op === 'dec') adjustNotesFontSize(-0.1);
        else if (op === 'reset') applyNotesFontSize(1);
      }
      document.addEventListener('click', handleNotesFontClick);

      // ── 8d. Toolbar button actions (C-3) ────────────────────────
      function handleToolbarClick(e) {
        const btn = e.target.closest && e.target.closest('.nav-btn[data-action]');
        if (!btn) return;
        e.preventDefault();
        const action = btn.getAttribute('data-action');
        switch (action) {
          case 'notes': toggleNotes(); break;
          case 'overview': openOverview(); break;
          case 'goto': openGoto(); break;
          case 'camera': window.__astlide_media && window.__astlide_media.toggleCamera(); break;
          case 'record': window.__astlide_media && window.__astlide_media.toggleRecording(); break;
          case 'draw': setTool('draw'); break;
          case 'laser': setTool('laser'); break;
          case 'presenter': {
            const u = new URL(window.location.href);
            u.searchParams.set('presenter', '');
            window.open(u.toString(), 'astlide-presenter', 'width=1280,height=800,menubar=no,toolbar=no,status=no');
            break;
          }
          case 'fullscreen': {
            if (document.fullscreenElement) document.exitFullscreen?.();
            else document.documentElement.requestFullscreen?.();
            break;
          }
          case 'print': toggleUrlFlag('print'); break;
          case 'share': toggleUrlFlag('share'); break;
          case 'download': downloadPdf(); break;
        }
      }
      document.addEventListener('click', handleToolbarClick);

      // ── 8e. PDF download via @astlide/crispdf (lazy-loaded) ─────
      const pdfOverlay = document.getElementById('pdf-overlay');
      const pdfBar = document.getElementById('pdf-overlay-bar');
      const pdfStatus = document.getElementById('pdf-overlay-status');
      let pdfBusy = false;

      function setPdfStatus(text, percent) {
        if (pdfStatus) pdfStatus.textContent = text;
        if (pdfBar && typeof percent === 'number') pdfBar.style.width = Math.max(0, Math.min(100, percent)) + '%';
      }

      function showPdfOverlay(show) {
        if (!pdfOverlay) return;
        pdfOverlay.setAttribute('aria-hidden', String(!show));
        pdfOverlay.classList.toggle('open', !!show);
      }

      async function downloadPdf() {
        if (pdfBusy) return;
        if (!window.__astlide_download_pdf) {
          console.error('[astlide] PDF download module is not available');
          return;
        }
        pdfBusy = true;
        showPdfOverlay(true);
        setPdfStatus('Loading PDF engine…', 0);
        try {
          const { warnings } = await window.__astlide_download_pdf({
            deck,
            onProgress: (done, total) => {
              setPdfStatus('Rendering slide ' + done + ' / ' + total, (done / total) * 100);
            },
          });
          setPdfStatus('Saving…', 100);
          if (warnings && warnings.length) {
            console.warn('[astlide] PDF export warnings:', warnings);
          }
        } catch (err) {
          console.error('[astlide] PDF export failed:', err);
          // Friendly text ONLY when crispdf truly isn't installed — match the
          // specific Vite/Node "cannot find module" shape, not just any string
          // that happens to contain "crispdf".
          const missingCrispdf =
            err && err.message &&
            (err.code === 'ERR_MODULE_NOT_FOUND' || /Cannot find (?:module|package) ['"]@astlide\/crispdf/i.test(err.message));
          const msg = missingCrispdf
            ? 'Install @astlide/crispdf to enable PDF download.'
            : 'PDF export failed — see console for details.';
          setPdfStatus(msg, 0);
          await new Promise((r) => setTimeout(r, 2500));
        } finally {
          showPdfOverlay(false);
          pdfBusy = false;
        }
      }

      // ── 9. Presenter timer (manual start/pause/reset) ──────────
      const timerEl = document.getElementById('presenter-timer');
      const timerBtn = document.getElementById('timer-btn');
      const timerResetBtn = document.getElementById('timer-reset');
      let timerInterval = null;
      let timerRunning = false;
      let timerElapsed = 0;
      let timerStartTime = 0;

      function formatTimer(secs) {
        const m = String(Math.floor(secs / 60)).padStart(2, '0');
        const s = String(secs % 60).padStart(2, '0');
        return m + ':' + s;
      }

      if (timerBtn) {
        timerBtn.addEventListener('click', () => {
          if (timerRunning) {
            timerElapsed += Math.floor((Date.now() - timerStartTime) / 1000);
            clearInterval(timerInterval);
            timerInterval = null;
            timerRunning = false;
            timerBtn.textContent = '▶';
            timerBtn.title = 'Resume timer';
            timerBtn.setAttribute('aria-label', 'Resume timer');
          } else {
            timerStartTime = Date.now();
            timerRunning = true;
            timerInterval = setInterval(() => {
              const elapsed = timerElapsed + Math.floor((Date.now() - timerStartTime) / 1000);
              if (timerEl) timerEl.textContent = formatTimer(elapsed);
            }, 1000);
            timerBtn.textContent = '⏸';
            timerBtn.title = 'Pause timer';
            timerBtn.setAttribute('aria-label', 'Pause timer');
          }
        });
      }

      if (timerResetBtn) {
        timerResetBtn.addEventListener('click', () => {
          if (timerInterval) clearInterval(timerInterval);
          timerInterval = null;
          timerRunning = false;
          timerElapsed = 0;
          timerStartTime = 0;
          if (timerEl) timerEl.textContent = '00:00';
          if (timerBtn) {
            timerBtn.textContent = '▶';
            timerBtn.title = 'Start timer';
            timerBtn.setAttribute('aria-label', 'Start timer');
          }
        });
      }

      // ── 10. Keyboard shortcuts ──────────────────────────────────
      function handleKeydown(e) {
        if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

        if (overviewOpen) {
          if (e.key === 'Escape' || e.key === 'o') closeOverview();
          return;
        }

        switch (e.key) {
          case 'ArrowRight':
          case ' ':
            e.preventDefault();
            goNext();
            break;
          case 'ArrowLeft':
            e.preventDefault();
            goPrev();
            break;
          case 'ArrowUp':
          case 'Home':
            e.preventDefault();
            broadcastSlide(firstSlide);
            navTo(deckUrl + '/' + firstSlide + (isPresenter ? '?presenter' : ''));
            break;
          case 'ArrowDown':
          case 'End':
            e.preventDefault();
            broadcastSlide(lastSlide);
            navTo(deckUrl + '/' + lastSlide + (isPresenter ? '?presenter' : ''));
            break;
          case 'f':
            if (!isPresenter) document.documentElement.requestFullscreen && document.documentElement.requestFullscreen();
            break;
          case 'Escape':
            if (tool) setTool(tool);
            else if (document.fullscreenElement) document.exitFullscreen && document.exitFullscreen();
            else if (notesOpen) toggleNotes();
            break;
          case 'o':
            if (!isPresenter) openOverview();
            break;
          case 'g':
            e.preventDefault(); // keep the "g" out of the dialog's input
            openGoto();
            break;
          case 'd':
            setTool('draw');
            break;
          case 'l':
            setTool('laser');
            break;
          case 'v':
            if (window.__astlide_media) window.__astlide_media.toggleCamera();
            break;
          case 'r':
            if (window.__astlide_media) window.__astlide_media.toggleRecording();
            break;
          case 'e':
            // Dev only: the editor module isn't loaded in production builds.
            if (window.__astlide_editor && !isPresenter) window.__astlide_editor.toggle();
            break;
          case 'c':
            if (tool === 'draw') clearDrawings(true);
            break;
          case 'C':
            if (tool === 'draw') clearDeckDrawings(true);
            break;
          case 'p':
            if (!isPresenter) {
              const u = new URL(window.location.href);
              u.searchParams.set('presenter', '');
              window.open(u.toString(), 'astlide-presenter', 'width=1280,height=800,menubar=no,toolbar=no,status=no');
            }
            break;
          case 'n':
            if (!isPresenter) toggleNotes();
            break;
          case 's':
            if (!isPresenter) toggleUrlFlag('share');
            break;
          case '>':
          case '.':
            if (e.shiftKey) { e.preventDefault(); adjustNotesFontSize(0.1); }
            break;
          case '<':
          case ',':
            if (e.shiftKey) { e.preventDefault(); adjustNotesFontSize(-0.1); }
            break;
        }
      }

      if (!isEmbedded) document.addEventListener('keydown', handleKeydown);

      // ── 11. Touch / swipe support ──────────────────────────────
      let touchStartX = 0;
      let touchStartY = 0;

      function handleTouchstart(e) {
        touchStartX = e.changedTouches[0].clientX;
        touchStartY = e.changedTouches[0].clientY;
      }

      function handleTouchend(e) {
        if (tool) return; // drawing / pointing, not swiping
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = e.changedTouches[0].clientY - touchStartY;
        if (Math.abs(dx) < 30 && Math.abs(dy) < 30) return;
        if (Math.abs(dx) > Math.abs(dy)) {
          if (dx < 0) goNext();
          else goPrev();
        }
      }

      if (!isEmbedded) {
        document.addEventListener('touchstart', handleTouchstart, { passive: true });
        document.addEventListener('touchend', handleTouchend, { passive: true });
      }

      // ── 12. Cleanup (called by next page on ClientRouter) ───
      window.__astlide_cleanup = function() {
        document.removeEventListener('keydown', handleKeydown);
        document.removeEventListener('touchstart', handleTouchstart);
        document.removeEventListener('touchend', handleTouchend);
        document.removeEventListener('click', handleNavClick, true);
        document.removeEventListener('click', handleNotesFontClick);
        document.removeEventListener('click', handleToolbarClick);
        window.removeEventListener('resize', updateScale);
        if (timerInterval) clearInterval(timerInterval);
        if (syncChannel) {
          syncChannel.onmessage = null; // Remove listener to prevent memory leaks
          try { syncChannel.close(); } catch(e) { /* ignore */ }
        }
      };
    </script>
  </body>
</html>

<style>
  html, body {
    margin: 0;
    padding: 0;
    overflow: hidden;
    width: 100vw;
    height: 100vh;
    background: #000;
  }

  /* A-2: in presenter mode, paint <html> the same color as the panel so the
     view-transition swap can't flash a #000 frame against the dark slate UI. */
  html[data-presenter],
  html[data-presenter] body {
    background: #0f172a;
  }

  /* B-1: ?print mode — hide all chrome and let the deck paint on white. */
  html[data-print],
  html[data-print] body {
    background: #fff;
    overflow: auto;
    height: auto;
  }
  html[data-print] .slide-nav,
  html[data-print] .progress-bar,
  html[data-print] .notes-overlay,
  html[data-print] .overview,
  html[data-print] .presenter-layout {
    display: none !important;
  }
  html[data-print] .presentation {
    background: transparent;
  }

  /* C-4: ?share mode — strip chrome but keep the slide visible, so the
     audience on a Web-conference screen-share sees a clean canvas. */
  html[data-share] .slide-nav,
  html[data-share] .progress-bar,
  html[data-share] .notes-overlay,
  html[data-share] .overview,
  html[data-share] .presenter-layout {
    display: none !important;
  }

  /* Embedded in an iframe (overview thumbnail / presenter next-slide preview):
     render the slide only. */
  html[data-embed] .slide-nav,
  html[data-embed] .progress-bar,
  html[data-embed] .notes-overlay,
  html[data-embed] .overview,
  html[data-embed] .presenter-layout,
  html[data-embed] .skip-link,
  html[data-embed] :global(astro-dev-toolbar) {
    display: none !important;
  }

  /* ── Skip link (visually hidden, visible on focus) ── */
  .skip-link {
    position: fixed;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary, #3b82f6);
    color: white;
    text-decoration: none;
    border-radius: 0 0 0.5rem 0.5rem;
    font-family: system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: 0;
    outline: 2px solid white;
    outline-offset: 2px;
  }

  /* ── Screen reader only ── */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Progress bar ── */
  .progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: var(--astlide-progress-height, 3px);
    background: var(--astlide-progress-color, var(--color-primary, #3b82f6));

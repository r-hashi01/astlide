  /* ── Normal presentation ── */
  .presentation {
    width: 100vw;
    height: 100vh;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #000;
  }

  /* Dev editor (e) docked on the right: center the slide in what's left. */
  html[data-editor] .presentation {
    padding-right: var(--astlide-reserved-right, 0px);
  }

  .slide-scaler {
    position: relative;
    transform-origin: center center;
    flex-shrink: 0;
  }

  /* ── Camera bubble & recording indicator ── */
  .camera-bubble {
    position: fixed;
    right: 2rem;
    bottom: 5rem;
    width: var(--astlide-camera-size, 220px);
    height: var(--astlide-camera-size, 220px);

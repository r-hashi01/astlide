{
	"name": "@astlide/astro",
	"version": "3.0.2",
	"description": "Slides that live in your Astro site: Astlide's Astro integration for MDX / Markdown / HTML presentations — many decks per site, presenter view, PDF and editable PowerPoint (PPTX) export in your own template, PPTX / Google Slides import",
	"type": "module",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./loader": "./src/loader.ts",
		"./components/*": "./src/components/*",
		"./internal/*.astro": "./src/internal/*.astro",
		"./internal/*.ts": "./src/internal/*.ts",
		"./internal/*": "./src/internal/*.ts"
	},
	"bin": {
		"astlide": "./bin/astlide.js"
	},
	"files": [
		"src",
		"bin",
		"CHANGELOG.md"
	],
	"scripts": {
		"prepublishOnly": "echo '✓ @astlide/astro ready to publish (source-only package)'"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/r-hashi01/astlide.git",
		"directory": "packages/astro"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"sideEffects": [
		"*.css",
		"*.astro"
	],
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://astlide.dev/",
	"bugs": "https://github.com/r-hashi01/astlide/issues",
	"peerDependencies": {
		"astro": "^7.2.10"
	},
	"dependencies": {
		"@astlide/core": "workspace:*",
		"@astrojs/mdx": "^8.1.1",
		"katex": "^0.19.1",
		"zod": "^4.6.7"
	},
	"keywords": [
		"astro",
		"astro-integration",
		"astro-loader",
		"withastro",
		"slides",
		"presentation",
		"slideshow",
		"deck",
		"mdx",
		"markdown",
		"pptx",
		"powerpoint",
		"google-slides",
		"pdf"
	],
	"license": "MIT"
}

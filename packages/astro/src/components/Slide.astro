---
import '@astlide/core/styles/slide.css';
import { sanitizeBackground } from '@astlide/core/utils/sanitize';
import { slideShell } from '@astlide/core/runtime/slide';
import { withBaseIfRootRelative } from '@astlide/core/utils/base-path';
import { layouts as pluginLayouts } from 'virtual:astlide/layouts';
import { decorators as slideDecorators } from 'virtual:astlide/decorators';
import { templates } from 'virtual:astlide/templates';
import { slideContentComments } from '@astlide/core/utils/slide-mark';

interface Props {
  layout?: string;
  transition?: string;
  background?: string;
  class?: string;
  slideNumber?: number;
  totalSlides?: number;
  /** The deck's theme: a PowerPoint template theme draws its layout's artwork. */
  theme?: string;
}

const {
  layout = 'default',
  transition = 'fade',
  background,
  class: className,
  slideNumber,
  totalSlides,
  theme,
} = Astro.props;

// The section's classes, background, template artwork: shared with other
// hosts through @astlide/core/runtime/slide (styles in styles/slide.css).
const template = theme ? templates[theme] : undefined;
const shell = slideShell({
  layout, transition, background, className, slideNumber, totalSlides, template,
  resolveUrl: withBaseIfRootRelative,
});
const safeBackground = background ? sanitizeBackground(background) : undefined;

// C-5: plugin-contributed layout component, if any, owns the slide markup.
const LayoutComponent = (pluginLayouts as Record<string, unknown>)[layout] as
  | undefined
  | ((_props: Record<string, unknown>) => unknown);

// Every-slide decorators (logo / footer / page number / home link).
const decoratorProps = { layout, transition, slideNumber, totalSlides };
---

{LayoutComponent ? (
  <LayoutComponent
    layout={layout}
    transition={transition}
    background={safeBackground}
    class={className}
    slideNumber={slideNumber}
    totalSlides={totalSlides}
  >
    <slot />
    {slideDecorators.map((Decorator) => <Decorator {...decoratorProps} />)}
  </LayoutComponent>
) : (
  <section
    class:list={shell.classes}
    data-transition={shell.transition}
    style={shell.style}
    role="region"
    aria-roledescription="slide"
    aria-label={shell.ariaLabel}
  >
    {/* Template artwork comes from a .pptx (possibly someone else's): marked like slide content, so the build's CSP doesn't allow scripts in it. */}
    {shell.templateArt && <div class="astlide-tpl-art" set:html={`${slideContentComments(undefined).start}${shell.templateArt}${slideContentComments(undefined).end}`} />}
    <div class="slide-content">
      <slot />
    </div>
    {shell.templateNumber && <div class="astlide-tpl-number">{slideNumber}</div>}
    {slideDecorators.map((Decorator) => <Decorator {...decoratorProps} />)}
  </section>
)}


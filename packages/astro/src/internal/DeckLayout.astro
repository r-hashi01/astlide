---
import '@astlide/core/styles/base.css';
import '@astlide/core/styles/deck.css';
// All theme CSS is registered through the Astlide plugin API and emitted as side-effect
// imports by the `virtual:astlide/themes` Vite virtual module.
import 'virtual:astlide/themes';
import { ClientRouter } from 'astro:transitions';
import Favicon from '@astlide/astro/internal/Favicon.astro';
import FontLinks from '@astlide/astro/internal/FontLinks.astro';
import { sanitizeHTML } from '@astlide/core/utils/sanitize';
import { renderMarkdown } from '@astlide/core/utils/markdown';
import { basePath, pageUrl, trailingSlash, withBase } from '@astlide/core/utils/base-path';

// Vite defines injected by the astlide() integration
declare const __ASTLIDE_CSP__: boolean | string;
declare const __ASTLIDE_INDEXABLE__: boolean;
declare const __ASTLIDE_TOOLBAR__: string[];
declare const __ASTLIDE_DRAWINGS_PERSIST__: boolean;

const persistDrawings: boolean =
  typeof __ASTLIDE_DRAWINGS_PERSIST__ !== 'undefined' ? __ASTLIDE_DRAWINGS_PERSIST__ : false;
const toolbarItems: string[] =
  typeof __ASTLIDE_TOOLBAR__ !== 'undefined' && Array.isArray(__ASTLIDE_TOOLBAR__)
    ? __ASTLIDE_TOOLBAR__
    : ['prev', 'counter', 'next'];

const cspOption: boolean | string =
  typeof __ASTLIDE_CSP__ !== 'undefined' ? __ASTLIDE_CSP__ : true;
// Dev only: let Vite's client run its reconnect worker (see utils/csp).
const cspContent = cspFor(cspOption, DEFAULT_DECK_CSP, import.meta.env.DEV);

import type { DeckContext } from '@astlide/core/context';
import type { DeckRuntimeConfig } from '@astlide/core/runtime';
import { deckChromeAfter, deckChromeBefore, SLIDE_OVERLAYS, type DeckChromeProps } from '@astlide/core/runtime/chrome';
import { cspFor, cspHashable, DEFAULT_DECK_CSP } from '@astlide/astro/internal/csp';
import { notesIncluded } from '@astlide/core/utils/notes';

interface Props {
  title: string;
  theme?: string;
  currentSlide: number;
  totalSlides: number;
  deck: string;
  notes?: string;
  transition?: string;
  /** Typed deck/slide metadata published to `window.__astlide` for client scripts. */
  context?: DeckContext;
  /** Slide numbers and titles for the go-to-slide dialog (`g`). */
  outline?: Array<{ n: number; title: string }>;
  /** Dev only: project-relative source file of this slide, for the `e` editor. */
  sourcePath?: string;
  /** Dev only: the deck's source files in slide order (live updates on add/remove). */
  deckSources?: string[];
  /**
   * Neighbouring and first / last slides to navigate to. In production these
   * skip hidden slides (which only redirect); default: the adjacent numbers.
   */
  prevSlide?: number | null;
  nextSlide?: number | null;
  firstSlide?: number;
  lastSlide?: number;
}

const { title, theme = 'default', currentSlide, totalSlides, deck, notes, transition = 'fade', context, outline = [], sourcePath, deckSources } = Astro.props;
const {
  prevSlide = currentSlide > 1 ? currentSlide - 1 : null,
  nextSlide = currentSlide < totalSlides ? currentSlide + 1 : null,
  firstSlide = 1,
  lastSlide = totalSlides,
} = Astro.props;
// `notes: "dev"`: built pages carry no notes (see utils/notes).
const sanitizedNotes =
  notesIncluded && notes ? sanitizeHTML(await renderMarkdown(notes)) : undefined;
const noNotes = notesIncluded ? 'No notes for this slide.' : 'Speaker notes are not published with this deck.';
// Internal links honour Astro's `base` (sub-path deployments).
const slideHref = (n: number, query = '') => pageUrl(`/${deck}/${n}${query}`);
const chrome: DeckChromeProps = {
  currentSlide, totalSlides, prevSlide, nextSlide,
  toolbar: toolbarItems,
  slideHref,
  homeHref: withBase('/'),
  notesHtml: sanitizedNotes,
  noNotesText: noNotes,
};
const indexable = typeof __ASTLIDE_INDEXABLE__ !== 'undefined' ? __ASTLIDE_INDEXABLE__ : false;
const runtimeConfig = JSON.stringify({
  trailingSlash, currentSlide, totalSlides, prevSlide, nextSlide, firstSlide, lastSlide,
  deck, deckContext: context ?? null, outline, basePath, persistDrawings,
} satisfies DeckRuntimeConfig).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="en" data-theme={theme} data-slide-transition={transition}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {cspContent && <meta http-equiv="Content-Security-Policy" content={cspContent} data-astlide-csp={cspHashable(cspOption) || undefined} />}
    <title>{title}</title>
    <Favicon />
    <meta name="description" content={`${title} — slide ${currentSlide} of ${totalSlides}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={`Slide deck: ${title}`} />
    <meta property="og:type" content="website" />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {nextSlide && <link rel="prefetch" href={slideHref(nextSlide)} />}
    <FontLinks />
    <ClientRouter />
    <script is:inline>
      (function () {
        // A-4: in the dedicated presenter popup (window.name === 'astlide-presenter'),
        // treat the window as sticky-presenter so transient ?presenter query drops
        // during ClientRouter swaps don't kick the popup back to normal mode.
        function isStickyPresenter() {
          try { return window.name === 'astlide-presenter'; } catch (_) { return false; }
        }
        function applyFlags(doc, search) {
          var p = new URLSearchParams(search);
          doc.documentElement.toggleAttribute('data-presenter', p.has('presenter') || isStickyPresenter());
          doc.documentElement.toggleAttribute('data-print', p.has('print'));
          doc.documentElement.toggleAttribute('data-share', p.has('share'));
          // Rendered inside an iframe (overview thumbnails, presenter next-slide
          // preview): hide chrome and skip navigation/sync — see isEmbedded below.
          doc.documentElement.toggleAttribute('data-embed', window.self !== window.top);
        }
        applyFlags(document, location.search);
        if (!window.__astlide_swap_listeners__) {
          window.__astlide_swap_listeners__ = true;
          // The slide change in flight, if any: printing mid-change would put the
          // old slide's snapshot on paper over the new one, so finish it first.
          var running = null;
          document.addEventListener('astro:before-swap', function (e) {
            // Set flags on the new document BEFORE the swap renders, avoiding a flash (A-1, A-2).
            applyFlags(e.newDocument, new URL(e.to, location.origin).search);
            running = e.viewTransition || null;
            if (running) running.finished.finally(function () { running = null; });
          });
          window.addEventListener('beforeprint', function () {
            if (running) running.skipTransition();
          });
          document.addEventListener('astro:after-swap', function () {
            applyFlags(document, location.search);
          });
        }
      })();
    </script>
  </head>
  <body data-total-slides={totalSlides} data-current-slide={currentSlide} data-deck={deck} data-slide-transition={transition} data-source-path={sourcePath} data-deck-sources={deckSources && JSON.stringify(deckSources)}>

    <!-- Skip link, announcer, progress bar, presenter panel (@astlide/core/runtime/chrome) -->
    <Fragment set:html={deckChromeBefore(chrome)} />

    <!-- Normal presentation layout (always rendered with slot) -->
    <div class="presentation" role="main" aria-label="Slide presentation">
      <div class="slide-scaler" id="slide-scaler" tabindex="-1" transition:name="slide-content" transition:animate="none">
        <slot />
        <!-- Pen / laser overlays, in slide coordinates (scale with the slide) -->
        <Fragment set:html={SLIDE_OVERLAYS} />
      </div>
    </div>

    <!-- Dev editor (e) host: persisted so live refreshes don't interrupt typing. -->
    {import.meta.env.DEV && <div id="astlide-editor-host" transition:persist="astlide-editor-host"></div>}

    <!-- Camera bubble (v). transition:persist keeps the live stream across slides. -->
    <div id="astlide-camera" class="camera-bubble" transition:persist="astlide-camera" aria-label="Camera" hidden>
      <video autoplay muted playsinline></video>
    </div>

    <!-- Toolbar and overlays (@astlide/core/runtime/chrome) -->
    <Fragment set:html={deckChromeAfter(chrome)} />

    <!-- Module script: expose Astro navigate() for ClientRouter -->
    <script>
      import { navigate } from 'astro:transitions/client';
      window.__astlide_navigate = navigate;
    </script>

    <!-- Module script: camera bubble + recording (state survives navigations). -->
    <script>
      import { toggleCamera, toggleRecording, syncMediaUi } from '@astlide/core/runtime/media';
      window.__astlide_media = {
        toggleCamera,
        toggleRecording: () => toggleRecording((window.__astlide && window.__astlide.deck) || 'astlide'),
      };
      document.addEventListener('astro:page-load', syncMediaUi);
    </script>

    <!-- Module script: dev-only slide editor (e). Tree-shaken from production builds. -->
    <script>
      if (import.meta.env.DEV) {
        import('@astlide/astro/internal/editor').then(({ toggleEditor, initEditor }) => {
          window.__astlide_editor = { toggle: () => toggleEditor() };
          initEditor();
          document.addEventListener('astro:page-load', initEditor);
        });
      }
    </script>

    <!-- Module script: render ```mermaid diagrams (loads mermaid only when a slide has one). -->
    <script>
      import { renderDiagrams } from '@astlide/astro/internal/diagrams-astro';
      // Fires on the first load and after every ClientRouter navigation.
      document.addEventListener('astro:page-load', () => { renderDiagrams(); });
    </script>

    <!-- Module script: lazy-load the PDF export pipeline on demand. -->
    <script>
      window.__astlide_download_pdf = async function (opts) {
        const mod = await import('@astlide/core/runtime/pdf-export');
        const result = await mod.exportDeckToPdf(opts);
        mod.downloadBlob(result.blob, opts.deck + '.pdf');
        return result;
      };
    </script>

    <!-- The deck runtime (@astlide/core/runtime), set up for this slide: the
         config travels as JSON ("<" escaped, so slide titles can't end the
         element) and is read again on every ClientRouter navigation. -->
    <script type="application/json" id="astlide-deck-config" set:html={runtimeConfig} />
    <script>
      import { mountDeck } from '@astlide/core/runtime';
      // Fires on the first load and after every ClientRouter navigation.
      document.addEventListener('astro:page-load', () => {
        const el = document.getElementById('astlide-deck-config');
        if (el?.textContent) mountDeck(JSON.parse(el.textContent));
      });
    </script>
  </body>
</html>


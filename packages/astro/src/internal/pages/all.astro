---
/**
 * Print-friendly view that stacks every slide of a deck in one document.
 *
 * Lets Chromium (via Playwright's `page.pdf()`) emit a multi-page PDF in a single
 * shot, removing the need for pdf-lib's per-page merge. Not exposed in the
 * regular deck navigation — accessed by the CLI exporter and the in-browser
 * "download PDF" button only.
 */
import { getCollection, render } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import { deckConfigSchema } from '@astlide/core/schema';
import type { DeckConfig } from '@astlide/core/schema';
import '@astlide/core/styles/base.css';
import '@astlide/core/styles/print.css';
import 'virtual:astlide/themes';
import Slide from '@astlide/astro/components/Slide.astro';
import Left from '@astlide/astro/components/Left.astro';
import Right from '@astlide/astro/components/Right.astro';
import ImageSide from '@astlide/astro/components/ImageSide.astro';
import TextPanel from '@astlide/astro/components/TextPanel.astro';
// Aliased: Astro 7's compiler injects its own `Fragment` binding into every .astro file.
import SlideFragment from '@astlide/astro/components/Fragment.astro';
import Fragments from '@astlide/astro/components/Fragments.astro';
import Notes from '@astlide/astro/components/Notes.astro';
import Favicon from '@astlide/astro/internal/Favicon.astro';
import FontLinks from '@astlide/astro/internal/FontLinks.astro';
import SpeakerNotes from '@astlide/astro/components/SpeakerNotes.astro';
import Columns from '@astlide/astro/components/Columns.astro';
import CodeBlock from '@astlide/astro/components/CodeBlock.astro';
import Math from '@astlide/astro/components/Math.astro';
import YouTube from '@astlide/astro/components/YouTube.astro';
import Tweet from '@astlide/astro/components/Tweet.astro';
import { extractCommentNotes } from '@astlide/core/utils/comment-notes';
import { slideContentComments } from '@astlide/core/utils/slide-mark';
import { notesIncluded } from '@astlide/core/utils/notes';
import { cspFor, cspHashable, DEFAULT_DECK_CSP } from '@astlide/core/utils/csp';

declare const __ASTLIDE_CSP__: boolean | string;

export async function getStaticPaths() {
  const allSlides = await getCollection('decks');

  const deckMap = new Map<string, typeof allSlides>();
  for (const slide of allSlides) {
    const [deckName] = slide.id.split('/');
    if (!deckMap.has(deckName)) deckMap.set(deckName, []);
    deckMap.get(deckName)!.push(slide);
  }

  const paths: Array<{ params: { deck: string }; props: { deckName: string; slides: typeof allSlides; deckConfig: DeckConfig } }> = [];

  for (const [deckName, slides] of deckMap) {
    const sortedSlides = slides
      .filter((s) => !s.data.hidden)
      .sort((a, b) => a.id.localeCompare(b.id));

    const configPath = path.join(process.cwd(), 'src', 'content', 'decks', deckName, '_config.json');
    let deckConfig: DeckConfig = deckConfigSchema.parse({});
    if (fs.existsSync(configPath)) {
      try {
        const raw = JSON.parse(fs.readFileSync(configPath, 'utf-8'));
        const result = deckConfigSchema.safeParse(raw);
        if (result.success) deckConfig = result.data;
      } catch {
        /* ignore — diagnostics already surface in the regular slide route */
      }
    }

    paths.push({ params: { deck: deckName }, props: { deckName, slides: sortedSlides, deckConfig } });
  }

  return paths;
}

const { deckName, slides, deckConfig } = Astro.props;
const cspOption: boolean | string = typeof __ASTLIDE_CSP__ !== 'undefined' ? __ASTLIDE_CSP__ : true;
const cspContent = cspFor(cspOption, DEFAULT_DECK_CSP, import.meta.env.DEV);
// A slide's notes as in the slide route: frontmatter `notes`, else a trailing comment.
const notesOf = (slide: (typeof slides)[number]) =>
  slide.data.notes ?? extractCommentNotes(slide.body ?? '');
const totalSlides = slides.length;

// Render every slide's MDX content up front so the Astro page body stays declarative.
const rendered = await Promise.all(
  slides.map(async (slide) => {
    const { Content } = await render(slide);
    return { slide, Content };
  })
);
---
<!DOCTYPE html>
<html lang="en" data-theme={deckConfig.theme} data-print data-astlide-all>
  <head>
    <meta charset="UTF-8" />
    {cspContent && <meta http-equiv="Content-Security-Policy" content={cspContent} data-astlide-csp={cspHashable(cspOption) || undefined} />}
    <title>{deckConfig.title ?? deckName} — all slides</title>
    <Favicon />
    <FontLinks />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    {rendered.map(({ slide, Content }, i) => (
      <Slide
        layout={slide.data.slideLayout ?? 'default'}
        transition={slide.data.transition ?? 'none'}
        background={slide.data.background}
        class={slide.data.class}
        slideNumber={i + 1}
        totalSlides={totalSlides}
        theme={deckConfig.theme}
      >
        <Fragment set:html={slideContentComments(slide.filePath).start} /><Content components={{ Left, Right, ImageSide, TextPanel, Fragment: SlideFragment, Fragments, Notes, SpeakerNotes, Columns, CodeBlock, Math, YouTube, Tweet }} /><Fragment set:html={slideContentComments(slide.filePath).end} />
        {/* Frontmatter / comment notes, for exporters (PPTX speaker notes); hidden. */}
        {notesIncluded && notesOf(slide) && <div data-slide-notes="meta" hidden>{notesOf(slide)}</div>}
      </Slide>
    ))}
  </body>
</html>

<script>
  // Render ```mermaid diagrams; sets <html data-diagrams-ready> for the PDF exporters.
  import { renderDiagrams } from '@astlide/astro/internal/diagrams-astro';
  renderDiagrams();
</script>


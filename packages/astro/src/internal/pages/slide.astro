---
import { getCollection, render } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import { deckConfigSchema } from '@astlide/core/schema';
import type { DeckConfig } from '@astlide/core/schema';
import { setDeckContext } from '@astlide/core/context';
import { slideTitle } from '@astlide/core/utils/slide-title';
import { slidePage, type SlidePage } from '@astlide/core/deck/pages';
import { pageUrl } from '@astlide/core/utils/base-path';
import DeckLayout from '@astlide/astro/internal/DeckLayout.astro';
import ErrorOverlay, { type Diagnostic } from '@astlide/astro/internal/ErrorOverlay.astro';
import Slide from '@astlide/astro/components/Slide.astro';
import Left from '@astlide/astro/components/Left.astro';
import Right from '@astlide/astro/components/Right.astro';
import ImageSide from '@astlide/astro/components/ImageSide.astro';
import TextPanel from '@astlide/astro/components/TextPanel.astro';
// Aliased: Astro 7's compiler injects its own `Fragment` binding into every .astro file.
import SlideFragment from '@astlide/astro/components/Fragment.astro';
import Fragments from '@astlide/astro/components/Fragments.astro';
import Notes from '@astlide/astro/components/Notes.astro';
import SpeakerNotes from '@astlide/astro/components/SpeakerNotes.astro';
import Columns from '@astlide/astro/components/Columns.astro';
import CodeBlock from '@astlide/astro/components/CodeBlock.astro';
import Math from '@astlide/astro/components/Math.astro';
import YouTube from '@astlide/astro/components/YouTube.astro';
import Tweet from '@astlide/astro/components/Tweet.astro';
import { extractCommentNotes } from '@astlide/core/utils/comment-notes';
import { slideContentComments } from '@astlide/astro/internal/slide-mark';

export async function getStaticPaths() {
  const allSlides = await getCollection('decks');

  // Group slides by deck
  const deckMap = new Map<string, typeof allSlides>();
  for (const slide of allSlides) {
    const [deckName] = slide.id.split('/');
    if (!deckMap.has(deckName)) deckMap.set(deckName, []);
    deckMap.get(deckName)!.push(slide);
  }

  const paths: Array<{
    params: { deck: string; slide: string };
    props: {
      slide: (typeof allSlides)[0];
      deckName: string;
      deckConfig: DeckConfig;
      page: Omit<SlidePage, 'slide'>;
      configIssue: string | null;
      sources: string[] | undefined;
    };
  }> = [];

  for (const [deckName, slides] of deckMap) {
    const sortedSlides = slides
      .sort((a, b) => a.id.localeCompare(b.id));

    const configPath = path.join(process.cwd(), 'src', 'content', 'decks', deckName, '_config.json');
    let deckConfig: DeckConfig = deckConfigSchema.parse({});  // schema defaults
    let configIssue: string | null = null;
    if (fs.existsSync(configPath)) {
      try {
        const raw = JSON.parse(fs.readFileSync(configPath, 'utf-8'));
        const result = deckConfigSchema.safeParse(raw);
        if (result.success) {
          deckConfig = result.data;
        } else {
          configIssue = `Invalid _config.json: ${result.error.issues.map((i) => `${i.path.join('.') || '<root>'} — ${i.message}`).join('; ')}`;
        }
      } catch (e) {
        configIssue = `Malformed _config.json: ${(e as Error).message}`;
      }
    }

    // Numbering, navigation and outline as in every framework (`@astlide/core/deck/pages`):
    // hidden slides keep their number; in production their page redirects on.
    const deck = {
      name: deckName,
      config: deckConfig,
      slides: sortedSlides.map((entry) => ({ entry, data: entry.data, title: slideTitle(entry) })),
    };

    // Dev only: the deck's source files in order, so the live editor can find a
    // slide's new number after files are added or removed.
    const sources = import.meta.env.DEV ? sortedSlides.map((s) => s.filePath ?? '') : undefined;

    for (let i = 0; i < sortedSlides.length; i++) {
      // The page without its slide (the entry goes in `slide`).
      const { slide: _, ...page } = slidePage(deck, i + 1, { showHidden: import.meta.env.DEV })!;
      paths.push({
        params: { deck: deckName, slide: String(i + 1) },
        props: {
          slide: sortedSlides[i],
          deckName,
          deckConfig,    // typed as DeckConfig
          page,
          configIssue,
          sources,
        },
      });
    }
  }

  return paths;
}

const { slide, deckName, deckConfig, page, configIssue, sources } = Astro.props;
const { number: slideNumber, totalSlides, outline, deckContext } = page;
const nav = { prevSlide: page.prevSlide, nextSlide: page.nextSlide, firstSlide: page.firstSlide, lastSlide: page.lastSlide };
const { Content } = await render(slide);

const {
  slideLayout: layout = 'default',
  transition = 'fade',
  background,
  class: className,
  notes: frontmatterNotes,
} = slide.data;
// Speaker notes: frontmatter `notes`, else an HTML comment ending the slide.
// (<SpeakerNotes> in the body overrides both, client-side in DeckLayout.)
const notes = frontmatterNotes ?? extractCommentNotes(slide.body ?? '');

// A hidden slide in production: on to the next visible one.
if (page.redirectTo !== undefined) {
  return Astro.redirect(pageUrl(`/${deckName}/${page.redirectTo}`));
}

// Publish typed deck/slide metadata for components rendered inside this slide
// (server-side via getDeckContext(Astro); client-side via window.__astlide).
setDeckContext(Astro, deckContext);

// Vite-defined plugin name lists (resolved at build time by the astlide() integration).
declare const __ASTLIDE_LAYOUT_NAMES__: string[];
declare const __ASTLIDE_TRANSITION_NAMES__: string[];
declare const __ASTLIDE_THEME_NAMES__: string[];

// Dev-only diagnostics. Failing on these would block the whole deck for a typo, so we
// warn (console + on-screen overlay) and fall through to CSS defaults instead.
const diagnostics: Diagnostic[] = [];
if (import.meta.env.DEV) {
  const knownLayouts = typeof __ASTLIDE_LAYOUT_NAMES__ !== 'undefined' ? __ASTLIDE_LAYOUT_NAMES__ : [];
  const knownTransitions = typeof __ASTLIDE_TRANSITION_NAMES__ !== 'undefined' ? __ASTLIDE_TRANSITION_NAMES__ : [];
  const knownThemes = typeof __ASTLIDE_THEME_NAMES__ !== 'undefined' ? __ASTLIDE_THEME_NAMES__ : [];

  if (configIssue) {
    diagnostics.push({ severity: 'error', message: configIssue, source: `decks/${deckName}/_config.json` });
    console.error(`[astlide] ${configIssue} (decks/${deckName}/_config.json)`);
  }
  if (knownLayouts.length && !knownLayouts.includes(layout)) {
    const msg = `Unknown slideLayout "${layout}". Known: ${knownLayouts.join(', ')}`;
    diagnostics.push({ severity: 'warn', message: msg, source: `${deckName}/slide ${slideNumber}` });
    console.warn(`[astlide] ${msg} (${deckName}/slide ${slideNumber})`);
  }
  if (knownTransitions.length && !knownTransitions.includes(transition)) {
    const msg = `Unknown transition "${transition}". Known: ${knownTransitions.join(', ')}`;
    diagnostics.push({ severity: 'warn', message: msg, source: `${deckName}/slide ${slideNumber}` });
    console.warn(`[astlide] ${msg} (${deckName}/slide ${slideNumber})`);
  }
  if (deckConfig.theme && knownThemes.length && !knownThemes.includes(deckConfig.theme)) {
    const msg = `Unknown theme "${deckConfig.theme}". Known: ${knownThemes.join(', ')}`;
    diagnostics.push({ severity: 'warn', message: msg, source: `decks/${deckName}/_config.json` });
    console.warn(`[astlide] ${msg} (decks/${deckName})`);
  }
}
---

<DeckLayout
  title={`${deckConfig.title ?? deckName} - Slide ${slideNumber}`}
  theme={deckConfig.theme}
  currentSlide={slideNumber}
  totalSlides={totalSlides}
  deck={deckName}
  notes={notes}
  transition={transition}
  context={deckContext}
  outline={outline}
  sourcePath={import.meta.env.DEV ? slide.filePath : undefined}
  deckSources={sources}
  {...nav}
>
  <Slide
    layout={layout}
    transition={transition}
    background={background}
    class={className}
    slideNumber={slideNumber}
    totalSlides={totalSlides}
    theme={deckConfig.theme}
  >
    <Fragment set:html={slideContentComments(slide.filePath).start} /><Content components={{ Left, Right, ImageSide, TextPanel, Fragment: SlideFragment, Fragments, Notes, SpeakerNotes, Columns, CodeBlock, Math, YouTube, Tweet }} /><Fragment set:html={slideContentComments(slide.filePath).end} />
  </Slide>
  {import.meta.env.DEV && diagnostics.length > 0 && <ErrorOverlay diagnostics={diagnostics} />}
</DeckLayout>

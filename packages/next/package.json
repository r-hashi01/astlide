{
	"name": "@astlide/next",
	"version": "3.0.1",
	"description": "Astlide for Next.js (App Router): decks from a folder as pages, presenter mode, print view and exports — the same Markdown, HTML and MDX decks as an Astlide site",
	"type": "module",
	"license": "MIT",
	"homepage": "https://astlide.dev/",
	"bugs": "https://github.com/r-hashi01/astlide/issues",
	"engines": {
		"node": ">=22.12.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"nextjs",
		"next",
		"react",
		"slides",
		"presentation",
		"mdx",
		"astlide"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/r-hashi01/astlide.git",
		"directory": "packages/next"
	},
	"exports": {
		".": "./src/index.tsx",
		"./config": "./src/config.js",
		"./client": "./src/client.tsx",
		"./styles": "./src/styles.ts",
		"./mermaid": "./src/mermaid.tsx"
	},
	"files": [
		"src",
		"CHANGELOG.md"
	],
	"peerDependencies": {
		"next": ">=15",
		"react": ">=19",
		"react-dom": ">=19",
		"mermaid": ">=11"
	},
	"dependencies": {
		"@astlide/core": "workspace:*",
		"@astlide/react": "workspace:*",
		"katex": "^0.19.1"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"next": "^16.4.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"peerDependenciesMeta": {
		"mermaid": {
			"optional": true
		}
	}
}

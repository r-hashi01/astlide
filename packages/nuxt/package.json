{
	"name": "@astlide/nuxt",
	"version": "2.11.0",
	"description": "Astlide for Nuxt: decks from a folder as pages, presenter mode, print view and exports — the same Markdown, HTML and MDX decks as an Astlide site",
	"type": "module",
	"license": "MIT",
	"homepage": "https://astlide.dev/",
	"bugs": "https://github.com/r-hashi01/astlide/issues",
	"engines": {
		"node": ">=22.12.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"nuxt",
		"nuxt-module",
		"vue",
		"slides",
		"presentation",
		"mdx",
		"astlide"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/r-hashi01/astlide.git",
		"directory": "packages/nuxt"
	},
	"exports": {
		".": "./src/module.ts"
	},
	"files": [
		"src",
		"CHANGELOG.md"
	],
	"peerDependencies": {
		"nuxt": ">=4",
		"vue": ">=3.4",
		"mermaid": ">=11"
	},
	"peerDependenciesMeta": {
		"mermaid": {
			"optional": true
		}
	},
	"dependencies": {
		"@astlide/core": "workspace:*",
		"@astlide/vue": "workspace:*",
		"@nuxt/kit": "^4.6.3",
		"katex": "^0.19.1"
	},
	"devDependencies": {
		"nuxt": "^4.6.3",
		"vue": "^3.5.44"
	}
}
